---
import Base from '../../../layouts/Base.astro'
import EditorApp from '../../../editor/EditorApp'
import { TEMPLATES } from '../../../editor/templates'
import { business } from '../../../config/site'

// Prototype editor: the same designer in simple mode, with a "More options" switch. Nothing is ordered.
export function getStaticPaths() {
  return TEMPLATES.map((t) => ({ params: { template: t.id }, props: { name: t.name } }))
}
const { template } = Astro.params
const { name } = Astro.props
const domain = import.meta.env.SHOPIFY_STORE_DOMAIN
const token = import.meta.env.SHOPIFY_STOREFRONT_TOKEN
const shop = domain && token ? { domain, token } : null
---
<Base title={`${name} (prototype) | Kemp & Sons Printing`} noindex>
  <main id="main">
    <EditorApp client:only="react" templateId={template} shop={shop} backHref="/prototype/#browse" phone={business.phone} phoneHref={business.phoneHref} prototype />
  </main>
</Base>
