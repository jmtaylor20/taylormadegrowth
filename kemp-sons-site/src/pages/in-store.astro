---
/**
 * In-store kiosk: every product on one touch-friendly screen, nothing else.
 * Not linked from the site and kept out of search results. Opening it turns
 * on kiosk mode for the tab (see src/editor/kiosk.ts): the designer comes
 * back here, and a customer's work is cleared when they check out or walk away.
 */
import Base from '../layouts/Base.astro'
import LivePrices from '../components/LivePrices.astro'
import TemplateThumb from '../editor/TemplateThumb'
import KioskAttract from '../editor/KioskAttract'
import KioskChooser from '../editor/KioskChooser'
import { productLines, business } from '../config/site'
import { templatesIn } from '../editor/templates'
import { formatOf, formatsFor } from '../lib/formats'
import { getStartingPrice, formatPrice } from '../lib/shopify'

/**
 * Every piece is drawn at the same scale: the widest folded piece (8.5 in)
 * fills the frame's width, so sizes compare at a glance.
 */
const SCALE_W = 8.5
const scaleStyle = (t: (typeof lines)[number]['items'][number]['t']) => {
  const c = t.thumbnailCrop ?? t.trim
  return `width: ${((c.w / SCALE_W) * 100).toFixed(2)}%; aspect-ratio: ${c.w} / ${c.h};`
}

const lines = (
  await Promise.all(
    productLines.map(async (line) => ({
      line,
      items: await Promise.all(templatesIn(line.collection).map(async (t) => ({ t, size: formatOf(t), from: formatPrice(await getStartingPrice(t.shopifyHandle)) }))),
      sizes: formatsFor(templatesIn(line.collection)),
    })),
  )
).filter((l) => l.items.length > 0)

/** For the choose screen: each line with a few designs spread through its list to fan out. */
const chooserLines = lines.map(({ line, items }) => {
  const ts = items.map((i) => i.t)
  const size = (t: (typeof ts)[number]) => t.thumbnailCrop ?? t.trim
  let picks = ts.map((t) => t.id)
  if (ts.length > 3) {
    // Biggest cover in the middle, two covers of the same shape either side, so the fan is symmetric.
    const middle = [...ts].sort((a, b) => size(b).w * size(b).h - size(a).w * size(a).h)[0]
    const rest = ts.filter((t) => t !== middle)
    const key = (t: (typeof ts)[number]) => `${size(t).w}x${size(t).h}`
    const pair = rest.find((t, i) => rest.slice(i + 1).some((u) => key(u) === key(t)))
    const outer = pair ? [pair, rest.find((u) => u !== pair && key(u) === key(pair))!] : [rest[0], rest[rest.length - 1]]
    picks = [outer[0].id, middle.id, outer[1].id]
  }
  return { id: line.collection, name: line.name, count: ts.length, sample: picks }
})
---
<Base title={`Order here | ${business.name}`} description="In-store ordering." noindex>
  <div class="kiosk">
    <header class="k-top">
      <img src="/brand/kemp-sons-white.svg" alt={business.name} width="150" height="100" />
      <div class="k-title">
        <p class="k-kicker">Design it here. We print it here.</p>
        <h1 id="k-current">Design your order</h1>
        <p class="k-sub">Tap a design to start. Each one is shown to scale.</p>
      </div>
      <div class="k-actions">
        <button type="button" class="k-back" id="k-back">
          <span aria-hidden="true">&larr;</span> Choose a different product
        </button>
        <button type="button" class="k-full" id="k-full" aria-label="Full screen">Full screen</button>
      </div>
    </header>

    <main class="k-main">
      {lines.map(({ line, items, sizes }) => (
        <section id={line.collection} class="k-line" aria-label={line.name}>
          <h2 class="k-sr">{line.name}</h2>
          {sizes.length > 1 && (
            <div class="k-sizes" role="group" aria-label="Size">
              <button type="button" class="k-size-btn" data-size="" aria-pressed="true">
                All sizes <span class="k-size-n">{items.length}</span>
              </button>
              {sizes.map((f) => (
                <button type="button" class="k-size-btn" data-size={f.id} aria-pressed="false">
                  {f.name} <span class="k-size-n">{f.templates.length}</span>
                </button>
              ))}
            </div>
          )}
          <ol class="k-grid">
            {items.map(({ t, size, from }) => (
              <li data-size={size}>
                <a class="k-card" href={`/design/${t.id}/`}>
                  <div class="k-thumb">
                    <div class="k-scale" style={scaleStyle(t)}>
                      <TemplateThumb client:idle id={t.id} samples />
                    </div>
                  </div>
                  <div class="k-meta">
                    <p class="k-name">{t.name}</p>
                    <p class="k-size">{t.sizeLabel}</p>
                    <p class="k-row">
                      <span data-live-price={`product:${t.shopifyHandle}`}>{from ? `From ${from}` : ''}</span>
                      <span class="k-go">Start <span aria-hidden="true">&rarr;</span></span>
                    </p>
                  </div>
                </a>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </main>

    <footer class="k-foot">
      <p>Questions? Ask us at the counter, or call {business.phone}.</p>
    </footer>
  </div>
  <KioskChooser client:only="react" lines={chooserLines} />
  <KioskAttract client:only="react" />
  <LivePrices />
</Base>

<script>
  import { enterKiosk } from '../editor/kiosk'
  enterKiosk()
  document.getElementById('k-back')?.addEventListener('click', () => window.dispatchEvent(new Event('kiosk:choose')))
  const btn = document.getElementById('k-full')
  btn?.addEventListener('click', () => {
    if (document.fullscreenElement) document.exitFullscreen()
    else document.documentElement.requestFullscreen?.().catch(() => undefined)
  })
  // Size buttons: show one size of the current product. Kept in the hash (#line/size) so Back from the designer returns here.
  const applySize = () => {
    const [line, size = ''] = window.location.hash.slice(1).split('/')
    const section = line ? document.getElementById(line) : null
    if (!section?.classList.contains('k-line')) return
    const known = !!size && !!section.querySelector(`.k-size-btn[data-size="${CSS.escape(size)}"]`)
    const want = known ? size : ''
    section.querySelectorAll<HTMLButtonElement>('.k-size-btn').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.size === want)))
    section.querySelectorAll<HTMLElement>('.k-grid > li').forEach((li) => (li.hidden = !!want && li.dataset.size !== want))
  }
  document.querySelectorAll<HTMLButtonElement>('.k-size-btn').forEach((b) =>
    b.addEventListener('click', () => {
      const line = b.closest('.k-line')!.id
      history.replaceState(null, '', `${window.location.pathname}#${line}${b.dataset.size ? `/${b.dataset.size}` : ''}`)
      applySize()
      window.scrollTo({ top: 0, behavior: 'smooth' })
    }),
  )
  window.addEventListener('kiosk:line', applySize)
  applySize()
  // No long-press menus or accidental text selection on a touch screen.
  document.addEventListener('contextmenu', (e) => e.preventDefault())
</script>

<style is:global>
  /* Screensaver (KioskAttract): "fresh off the press" */
  .ka { position: fixed; inset: 0; z-index: 100; overflow: hidden; cursor: pointer; user-select: none; -webkit-user-select: none; color: var(--white);
    background: radial-gradient(120% 90% at 70% 45%, #17496a 0%, var(--navy-deep) 55%, #06141e 100%); display: grid; grid-template-rows: 1fr auto; }
  .ka-dots { position: absolute; inset: -10%; z-index: 0; opacity: 0.16; pointer-events: none;
    background-image: radial-gradient(circle, rgba(255,255,255,0.9) 1.2px, transparent 1.6px); background-size: 18px 18px;
    -webkit-mask-image: radial-gradient(70% 60% at 30% 70%, #000 0%, transparent 70%); mask-image: radial-gradient(70% 60% at 30% 70%, #000 0%, transparent 70%);
    animation: ka-dots 40s linear infinite; }
  @keyframes ka-dots { to { transform: translate3d(18px, -54px, 0); } }

  /* Registration marks in the corners, like a press sheet */
  .ka-reg { position: absolute; width: 38px; height: 38px; border: 1.5px solid rgba(255,255,255,0.45); border-radius: 50%; animation: ka-reg 24s linear infinite; z-index: 3; }
  .ka-reg::before, .ka-reg::after { content: ''; position: absolute; background: rgba(255,255,255,0.45); }
  .ka-reg::before { left: 50%; top: -10px; bottom: -10px; width: 1.5px; transform: translateX(-50%); }
  .ka-reg::after { top: 50%; left: -10px; right: -10px; height: 1.5px; transform: translateY(-50%); }
  .ka-reg-tl { top: 26px; left: 26px; } .ka-reg-tr { top: 26px; right: 26px; } .ka-reg-bl { bottom: 26px; left: 26px; } .ka-reg-br { bottom: 26px; right: 26px; }
  @keyframes ka-reg { to { transform: rotate(360deg); } }

  /* Background: printed sheets drifting up through 3D space */
  .ka-space { position: absolute; inset: 0; z-index: 0; perspective: 1100px; perspective-origin: 60% 40%; transform-style: preserve-3d; pointer-events: none; }
  .ka-sheet { position: absolute; bottom: -45vh; transform-style: preserve-3d; animation: ka-drift linear infinite; will-change: transform;
    box-shadow: 0 30px 50px -20px rgba(0,0,0,0.7); background: #fff; filter: saturate(0.75) brightness(0.8); }
  .ka-sheet img { width: 100%; height: 100%; object-fit: cover; display: block; }
  @keyframes ka-drift {
    from { transform: translate3d(0, 0, var(--z)) rotateX(var(--tilt)) rotateY(calc(var(--spin) * 0.6)) rotateZ(calc(var(--spin) * -0.4)); }
    to { transform: translate3d(0, -190vh, var(--z)) rotateX(calc(var(--tilt) * -1)) rotateY(calc(var(--spin) * -0.6)) rotateZ(calc(var(--spin) * 0.4)); }
  }

  .ka-layout { position: relative; z-index: 2; display: grid; grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr); align-items: center; padding: 6vh 6vw 0; min-height: 0; }
  .ka-copy { display: grid; gap: 2.2vh; justify-items: start; width: max-content; max-width: 40vw; }
  /* White logo, centered over the headline */
  .ka-logo { justify-self: center; width: clamp(220px, 18vw, 320px); height: auto; filter: drop-shadow(0 10px 24px rgba(0,0,0,0.45)); margin-bottom: 1vh; }
  .ka-kicker { font-family: var(--mono); font-size: clamp(13px, 1.1vw, 17px); text-transform: uppercase; letter-spacing: 0.22em; color: #9fd8ef;
    display: flex; align-items: center; gap: 12px; }
  .ka-kicker::before { content: ''; width: 34px; height: 2px; background: var(--red); }
  .ka-title { font-size: clamp(40px, 5.4vw, 92px); font-weight: 800; text-transform: uppercase; line-height: 0.95; letter-spacing: -0.01em; }
  /* contain: the paragraph wraps to the headline's width instead of widening the column */
  .ka-sub { font-size: clamp(17px, 1.45vw, 23px); line-height: 1.45; color: rgba(255,255,255,0.82); max-width: 34ch; contain: inline-size; width: 100%; }

  /* Hero: one design at a time comes off the press */
  .ka-stage { position: relative; z-index: 3; height: 72vh; perspective: 1600px; perspective-origin: 50% 40%; display: grid; place-items: center; }
  .ka-hero { position: relative; display: grid; justify-items: center; gap: 0; transform-style: preserve-3d; animation-name: ka-hero; animation-fill-mode: both; }
  @keyframes ka-hero {
    0% { opacity: 0; transform: translate3d(-34vw, 14vh, -1500px) rotateX(24deg) rotateY(60deg) rotateZ(-16deg); animation-timing-function: cubic-bezier(0.16, 0.8, 0.25, 1); }
    18% { opacity: 1; transform: translate3d(0, 0, 0) rotateX(7deg) rotateY(-14deg) rotateZ(-2deg); animation-timing-function: ease-in-out; }
    50% { transform: translate3d(0, -1.2vh, 40px) rotateX(3deg) rotateY(-5deg) rotateZ(-1deg); animation-timing-function: ease-in-out; }
    80% { opacity: 1; transform: translate3d(0, 0, 0) rotateX(6deg) rotateY(-12deg) rotateZ(-2deg); animation-timing-function: cubic-bezier(0.55, 0, 0.75, 0.2); }
    100% { opacity: 0; transform: translate3d(42vw, -10vh, -700px) rotateX(-8deg) rotateY(-72deg) rotateZ(10deg); }
  }
  .ka-stack { position: relative; height: 56vh; transform-style: preserve-3d; }
  .ka-under { position: absolute; inset: 0; background: #f4f4ef; box-shadow: 0 20px 40px -24px rgba(0,0,0,0.8); }
  .ka-under-1 { transform: translate3d(10px, 9px, -14px) rotateZ(1.6deg); }
  .ka-under-2 { transform: translate3d(20px, 18px, -28px) rotateZ(3.2deg); background: #e9e9e2; }
  .ka-card { position: absolute; inset: 0; overflow: hidden; background: #fff; transform: translateZ(1px);
    box-shadow: 0 50px 80px -30px rgba(0,0,0,0.85), 0 0 0 1px rgba(0,0,0,0.06); }
  .ka-card img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ka-shine { position: absolute; inset: -20%; background: linear-gradient(115deg, transparent 38%, rgba(255,255,255,0.55) 48%, transparent 58%);
    animation-name: ka-shine; animation-fill-mode: both; animation-timing-function: ease-in-out; }
  @keyframes ka-shine { 0%, 20% { transform: translateX(-70%); opacity: 0; } 24% { opacity: 1; } 38% { transform: translateX(70%); opacity: 0; } 100% { transform: translateX(70%); opacity: 0; } }

  /* Crop marks close in as the sheet lands, then trim away */
  .ka-crop { position: absolute; width: 34px; height: 34px; animation-name: ka-crop; animation-fill-mode: both; animation-timing-function: ease-out; transform: translateZ(2px); }
  .ka-crop::before, .ka-crop::after { content: ''; position: absolute; background: #9fd8ef; }
  .ka-crop::before { width: 26px; height: 2px; } .ka-crop::after { width: 2px; height: 26px; }
  .ka-crop-tl { top: -40px; left: -40px; } .ka-crop-tl::before { bottom: 0; right: 0; } .ka-crop-tl::after { bottom: 0; right: 0; }
  .ka-crop-tr { top: -40px; right: -40px; } .ka-crop-tr::before { bottom: 0; left: 0; } .ka-crop-tr::after { bottom: 0; left: 0; }
  .ka-crop-bl { bottom: -40px; left: -40px; } .ka-crop-bl::before { top: 0; right: 0; } .ka-crop-bl::after { top: 0; right: 0; }
  .ka-crop-br { bottom: -40px; right: -40px; } .ka-crop-br::before { top: 0; left: 0; } .ka-crop-br::after { top: 0; left: 0; }
  .ka-crop-tl::before, .ka-crop-tr::before { bottom: 6px; } .ka-crop-bl::before, .ka-crop-br::before { top: 6px; }
  .ka-crop-tl::after, .ka-crop-bl::after { right: 6px; } .ka-crop-tr::after, .ka-crop-br::after { left: 6px; }
  @keyframes ka-crop { 0%, 12% { opacity: 0; scale: 2.4; } 20% { opacity: 1; scale: 1; } 34% { opacity: 1; scale: 1; } 44%, 100% { opacity: 0; scale: 0.6; } }

  /* Job ticket */
  .ka-ticket { position: absolute; right: -14%; bottom: 7%; display: grid; gap: 4px; background: var(--white); color: var(--ink); padding: 14px 20px 16px;
    border-left: 6px solid var(--red); box-shadow: 0 24px 40px -20px rgba(0,0,0,0.75); transform: translateZ(60px); min-width: 15vw; max-width: 24vw;
    animation-name: ka-ticket; animation-fill-mode: both; }
  .ka-ticket-no { font-family: var(--mono); font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--red-ink); }
  .ka-ticket-name { font-size: clamp(20px, 1.8vw, 30px); font-weight: 800; text-transform: uppercase; line-height: 1.05; }
  .ka-ticket-meta { font-family: var(--mono); font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-2); }
  @keyframes ka-ticket {
    0%, 26% { opacity: 0; transform: translate3d(40px, 0, 60px) rotateZ(4deg); }
    34% { opacity: 1; transform: translate3d(0, 0, 60px) rotateZ(-2deg); }
    76% { opacity: 1; transform: translate3d(0, 0, 60px) rotateZ(-2deg); }
    84%, 100% { opacity: 0; transform: translate3d(20px, 10px, 60px) rotateZ(2deg); }
  }

  .ka-foot { position: relative; z-index: 2; display: grid; justify-items: center; gap: 2.4vh; padding: 0 6vw 5vh; }
  .ka-cmyk { display: flex; gap: 0; height: 8px; width: min(420px, 40vw); }
  .ka-cmyk span { flex: 1; } .ka-cmyk span:nth-child(1) { background: var(--c); } .ka-cmyk span:nth-child(2) { background: var(--m); }
  .ka-cmyk span:nth-child(3) { background: var(--y); } .ka-cmyk span:nth-child(4) { background: #000; outline: 1px solid rgba(255,255,255,0.25); }
  .ka-cta span { display: inline-block; background: var(--red); color: var(--white); padding: 18px 44px; font-size: clamp(22px, 2.4vw, 36px); font-weight: 800;
    text-transform: uppercase; letter-spacing: 0.06em; box-shadow: 0 18px 40px -16px rgba(237,28,36,0.7); animation: ka-pulse 2.6s ease-in-out infinite; }
  @keyframes ka-pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.045); } }

  @media (max-aspect-ratio: 1/1) {
    .ka-layout { grid-template-columns: 1fr; align-content: center; gap: 4vh; }
    .ka-copy { max-width: none; justify-items: center; text-align: center; }
    .ka-stage { height: 52vh; } .ka-stack { height: 42vh; } .ka-ticket { right: -6%; max-width: 40vw; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ka-sheet, .ka-dots, .ka-reg { animation: none; } .ka-cta span { animation: none; }
  }

  /* Choose screen (KioskChooser): the same navy press room as the screensaver */
  .kc { position: fixed; inset: 0; z-index: 90; overflow-x: hidden; overflow-y: auto; color: var(--white); user-select: none; -webkit-user-select: none;
    background: radial-gradient(120% 90% at 50% 35%, #17496a 0%, var(--navy-deep) 55%, #06141e 100%);
    display: grid; grid-template-rows: auto 1fr auto; justify-items: center; padding: 5vh 5vw 4vh; gap: 4vh; }
  .kc-dots { position: absolute; inset: -10%; opacity: 0.14; pointer-events: none;
    background-image: radial-gradient(circle, rgba(255,255,255,0.9) 1.2px, transparent 1.6px); background-size: 18px 18px;
    -webkit-mask-image: radial-gradient(60% 55% at 50% 60%, #000 0%, transparent 75%); mask-image: radial-gradient(60% 55% at 50% 60%, #000 0%, transparent 75%);
    animation: ka-dots 40s linear infinite; }
  .kc-head { position: relative; display: grid; justify-items: center; gap: 1.6vh; text-align: center; animation: kc-fade 0.6s ease-out both; }
  .kc-head img { width: clamp(180px, 13vw, 260px); height: auto; filter: drop-shadow(0 10px 24px rgba(0,0,0,0.45)); }
  .kc-kicker { font-family: var(--mono); font-size: clamp(13px, 1.1vw, 17px); text-transform: uppercase; letter-spacing: 0.22em; color: #9fd8ef; }
  .kc-title { font-size: clamp(34px, 4.4vw, 76px); font-weight: 800; text-transform: uppercase; line-height: 1; }
  .kc-cards { position: relative; display: flex; flex-wrap: wrap; gap: 4vw; justify-content: center; align-items: center; align-self: center; }
  .kc-card { position: relative; width: clamp(300px, 30vw, 470px); display: grid; justify-items: center; gap: 10px; padding: 26px 26px 24px;
    background: #fffdf8; color: var(--ink); border: 0; font: inherit; cursor: pointer; text-align: center;
    box-shadow: 0 34px 60px -26px rgba(0,0,0,0.85); animation: kc-deal 0.7s cubic-bezier(0.2, 0.9, 0.25, 1.15) both;
    transition: transform 0.15s var(--ease); }
  .kc-card:active { transform: scale(0.97) translateY(2px); }
  .kc-card:nth-child(odd) { --tilt: -1.4deg; } .kc-card:nth-child(even) { --tilt: 1.4deg; }
  @keyframes kc-deal { from { opacity: 0; transform: translateY(14vh) rotate(calc(var(--tilt) * 6)); } to { opacity: 1; transform: translateY(0) rotate(var(--tilt)); } }
  .kc-card { transform: rotate(var(--tilt)); }
  .kc-crop { position: absolute; width: 22px; height: 22px; border-color: rgba(255,255,255,0.75); border-style: solid; border-width: 0; }
  .kc-crop-tl { top: -30px; left: -30px; border-right-width: 1.5px; border-bottom-width: 1.5px; }
  .kc-crop-tr { top: -30px; right: -30px; border-left-width: 1.5px; border-bottom-width: 1.5px; }
  .kc-crop-bl { bottom: -30px; left: -30px; border-right-width: 1.5px; border-top-width: 1.5px; }
  .kc-crop-br { bottom: -30px; right: -30px; border-left-width: 1.5px; border-top-width: 1.5px; }
  .kc-fan { position: relative; display: block; height: clamp(170px, min(30vh, 22vw), 330px); width: 100%; margin-bottom: 8px; }
  .kc-fan-item { position: absolute; left: 50%; bottom: 0; background: #fff; box-shadow: 0 14px 24px -12px rgba(0,0,0,0.6); transform-origin: 50% 100%; }
  .kc-fan-item img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .kc-name { max-width: 100%; text-wrap: balance; font-size: clamp(22px, 1.9vw, 32px); font-weight: 800; text-transform: uppercase; line-height: 1.05; }
  .kc-count { font-family: var(--mono); font-size: 13px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-2); }
  .kc-go { margin-top: 6px; background: var(--red); color: var(--white); padding: 12px 26px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.06em; font-size: clamp(16px, 1.3vw, 20px); }
  .kc-cmyk { display: flex; height: 8px; width: min(420px, 40vw); }
  .kc-cmyk span { flex: 1; } .kc-cmyk span:nth-child(1) { background: var(--c); } .kc-cmyk span:nth-child(2) { background: var(--m); }
  .kc-cmyk span:nth-child(3) { background: var(--y); } .kc-cmyk span:nth-child(4) { background: #000; outline: 1px solid rgba(255,255,255,0.25); }
  @keyframes kc-fade { from { opacity: 0; transform: translateY(-2vh); } to { opacity: 1; transform: none; } }

  /* Chosen: the card pops, the others drop away */
  .kc.is-running .kc-card:not(.is-chosen) { animation: kc-drop 0.4s ease-in forwards; }
  .kc.is-running .kc-card.is-chosen { animation: kc-pop 0.45s cubic-bezier(0.3, 1.4, 0.5, 1) forwards; }
  @keyframes kc-drop { to { opacity: 0; transform: translateY(20vh) rotate(calc(var(--tilt) * 5)); } }
  @keyframes kc-pop { 50% { transform: scale(1.06) rotate(0deg); } to { transform: scale(1.02) rotate(0deg); } }

  /* The press pass: four ink stripes roll across like rollers, the paper follows the black,
     then a registration mark slides into register on the fresh sheet */
  .kc-press { position: fixed; inset: 0; z-index: 5; pointer-events: none; overflow: hidden; }
  .kc-paper { position: absolute; inset: -10% -20%; background: var(--stock); transform: translateX(-125%) skewX(-14deg);
    animation: kc-roll 0.6s cubic-bezier(0.3, 0, 0.2, 1) 0.5s forwards; }
  @keyframes kc-roll { to { transform: translateX(0) skewX(0deg); } }
  .kc-ink { position: absolute; top: -10%; bottom: -10%; left: 0; width: 30vw; transform: translateX(-60vw) skewX(-14deg);
