---
import Base from '../layouts/Base.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
---
<Base title="Page not found | Kemp & Sons Printing">
  <Header />
  <main id="main" class="nf">
    <div class="wrap inner">
      <p class="label">Page not found</p>
      <h1 class="headline">That page didn't make it to press.</h1>
      <div class="btn-row">
        <a class="btn btn-primary" href="/">Back to home</a>
        <a class="btn" href="/#products">Order online</a>
      </div>
    </div>
  </main>
  <Footer />
</Base>
<style>
  .nf { min-height: 80vh; display: flex; align-items: center; padding: calc(var(--header-h) + 60px) 0 80px; }
  .inner { display: grid; gap: 22px; max-width: 760px; }
</style>
