---
import Base from '../../layouts/Base.astro'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'
import ColorBar from '../../components/ColorBar.astro'
import LivePrices from '../../components/LivePrices.astro'
import TemplateThumb from '../../editor/TemplateThumb'
import { productLines, business } from '../../config/site'
import { templatesIn } from '../../editor/templates'
import { getStartingPrice, formatPrice } from '../../lib/shopify'

export function getStaticPaths() {
  return productLines.map((line) => ({ params: { collection: line.collection }, props: { line } }))
}

const { line } = Astro.props
const templates = await Promise.all(
  templatesIn(line.collection).map(async (t) => ({ t, from: formatPrice(await getStartingPrice(t.shopifyHandle)) })),
)
import { formatOf, formatsFor } from '../../lib/formats'
// Size filter, when a line comes in more than one size (funeral programs).
const sizes = formatsFor(templates.map(({ t }) => t))
const others = productLines.filter((l) => l.collection !== line.collection)
const pad = (n: number) => String(n).padStart(2, '0')

/**
 * Every piece is drawn at the same scale (the widest folded piece, 8.5 in,
 * fills the frame), standing on a shared baseline, so sizes compare at a glance.
 */
const SCALE_W = 8.5
const scaleStyle = (t: (typeof templates)[number]['t']) => {
  const c = t.thumbnailCrop ?? t.trim
  return `width: ${((c.w / SCALE_W) * 100).toFixed(2)}%; aspect-ratio: ${c.w} / ${c.h};`
}
import { rushFormatFor } from '../../../netlify/lib/price-groups'
// Rush (same-day shipping) is offered when any design in this line has a rush format.
const hasRush = templates.some(({ t }) => !!rushFormatFor(t.shopifyHandle))
---
<Base
  title={`${line.name} | Order online | ${business.name}, Opelika AL`}
  description={`${line.intro} ${line.blurb}`}
  image={templates.length ? `/previews/${templates[0].t.id}.jpg` : undefined}
  schema={templates.length ? {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: `${line.name} designs`,
    itemListElement: templates.map(({ t }, i) => ({ '@type': 'ListItem', position: i + 1, url: new URL(`/design/${t.id}/`, Astro.site).href, name: t.name })),
  } : undefined}
>
  <Header />
  <main id="main" class="shop">
    <section class="intro">
      <div class="wrap">
        <p class="label">Order online</p>
        <h1 class="headline">{line.name}</h1>
        <p class="lede">{line.intro}</p>
        {templates.length > 0 && <p class="ship-clock" data-ship-clock data-rush={hasRush ? '1' : undefined}><span class="dot" aria-hidden="true"></span><span data-ship-text></span></p>}
      </div>
    </section>

    <section class="warm" aria-label={`${line.name} designs`}>
    <div class="wrap designs">
      {sizes.length > 2 && (
        <div class="sizes" role="group" aria-label="Filter by size" data-size-filter>
          <span class="mono sizes-label">Size</span>
          <button type="button" class="size-btn is-on" data-size="" aria-pressed="true">All <span class="n">{templates.length}</span></button>
          {sizes.map((f) => (
            <button type="button" class="size-btn" data-size={f.id} aria-pressed="false">{f.name} <span class="n">{f.templates.length}</span><span class="fin">{f.finished}</span></button>
          ))}
        </div>
      )}
      {line.collection === 'christmas-cards' && (
        <a class="own" href="/start/#own">
          <span class="own-k mono">Have your own design?</span>
          <span>Made your card in Canva or an AI tool, or bought a design elsewhere? Upload it and we'll print it, with envelopes if you'd like. <u>Upload your card</u> <span aria-hidden="true">&rarr;</span></span>
        </a>
      )}
      {templates.length > 0 ? (
        <ol class="grid">
          {templates.map(({ t, from }, i) => (
            <li data-format={formatOf(t)}>
              <a class="card" href={`/design/${t.id}/`}>
                <div class="thumb">
                  <div class="scale" style={scaleStyle(t)}>
                    <TemplateThumb client:idle id={t.id} samples />
                  </div>
                </div>
                <div class="meta">
                  <p class="mono no">No. {pad(i + 1)} / {t.sizeLabel}</p>
                  <h2 class="sub">{t.name}</h2>
                  <p class="desc">{t.description}</p>
                  <p class="row">
                    <span class="mono" data-live-price={`product:${t.shopifyHandle}`}>{from ? `From ${from}` : ''}</span>
                    <span class="go">Personalize <span aria-hidden="true">&rarr;</span></span>
                  </p>
                </div>
              </a>
            </li>
          ))}
        </ol>
      ) : (
        <div class="soon">
          <p class="sub">We print {line.name.toLowerCase()} to order.</p>
          <p>Tell us what you need, send your logo or artwork if you have it, and we'll quote it within one business day. Our team can design it for you, too.</p>
          <div class="btn-row">
            <a class="btn btn-primary" href={`/?job=${encodeURIComponent('quoteJob' in line ? line.quoteJob : 'Something else')}#custom`}>Get a quote</a>
            <a class="btn" href={business.phoneHref}>Call {business.phone}</a>
          </div>
        </div>
      )}
      <p class="help">Need something different? <a href="/#custom">Send us a custom job</a> and we'll quote it within one business day.</p>
    </div>
    </section>

    <section class="more">
      <ColorBar />
      <div class="wrap">
        <p class="label">Also printed here</p>
        <ul class="others">
          {others.map((l) => <li><a href={`/shop/${l.collection}/`}>{l.name} <span aria-hidden="true">&rarr;</span></a></li>)}
        </ul>
      </div>
    </section>
  </main>
  <Footer />
  <LivePrices />
<script>
  const bar = document.querySelector<HTMLElement>('[data-size-filter]')
  if (bar) {
    const items = [...document.querySelectorAll<HTMLElement>('.grid > li[data-format]')]
    const apply = (size: string) => {
      bar.querySelectorAll<HTMLButtonElement>('.size-btn').forEach((b) => {
        const on = (b.dataset.size ?? '') === size
        b.classList.toggle('is-on', on)
        b.setAttribute('aria-pressed', String(on))
      })
      items.forEach((li) => (li.hidden = !!size && li.dataset.format !== size))
      try { size ? history.replaceState(null, '', `#size=${size}`) : history.replaceState(null, '', location.pathname) } catch {}
    }
    bar.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.size-btn')
      if (b) apply(b.dataset.size ?? '')
    })
    const m = location.hash.match(/size=([\w.-]+)/)
    if (m) apply(m[1])
  }
</script>
</Base>

<style>
  .shop { padding-top: var(--header-h); }
  .intro { padding: 64px 0 40px; border-bottom: 2px solid var(--ink); }
  .ship-clock { display: inline-flex; align-items: center; gap: 10px; justify-self: start; font-weight: 700; font-size: 15px; background: var(--white); border: 1.5px solid var(--ink); padding: 8px 14px; }
  .ship-clock:empty, .ship-clock:not(.is-on) { visibility: hidden; }
  .ship-clock .dot { width: 10px; height: 10px; border-radius: 50%; background: #b38600; flex: none; }
  .ship-clock.is-today .dot { background: #1e8a3c; box-shadow: 0 0 0 4px rgba(30, 138, 60, 0.18); }
  .intro .wrap { display: grid; gap: 18px; }
  /* Warm "proof table": designs drawn to scale on cream, soft shadows, no boxes (matches the in-store kiosk) */
  .warm { background: radial-gradient(120% 70% at 50% 0%, #fffaf2 0%, #f5ede1 55%, #efe4d4 100%); border-bottom: 2px solid var(--ink); }
  .designs { padding-top: 56px; padding-bottom: 72px; display: grid; gap: 40px; }
  .grid { list-style: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr)); gap: 52px 40px; }
  .grid > li { display: flex; }
  .grid > li[hidden] { display: none; }
  .sizes { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin: 0 0 44px; }
  .sizes-label { font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; margin-right: 6px; }
  .size-btn { font: inherit; font-weight: 600; font-size: 0.95rem; min-height: 44px; padding: 8px 16px; border: 1.5px solid var(--ink, #111); background: var(--paper, #fff); color: inherit; cursor: pointer; display: inline-flex; flex-wrap: wrap; align-items: baseline; gap: 2px 8px; text-align: left; }
  .size-btn .n { font-family: var(--font-mono, monospace); font-size: 0.75rem; opacity: 0.6; }
  .size-btn .fin { flex-basis: 100%; font-weight: 400; font-size: 0.78rem; opacity: 0.7; }
  .size-btn.is-on { background: var(--ink, #111); color: #fff; }
  .size-btn:focus-visible { outline: 3px solid var(--red, #e11d26); outline-offset: 2px; }
  @media (max-width: 720px) {
    .sizes { flex-wrap: nowrap; overflow-x: auto; margin: 0 calc(-1 * var(--gutter, 20px)) 32px; padding: 0 var(--gutter, 20px) 6px; scrollbar-width: none; }
    .sizes::-webkit-scrollbar { display: none; }
    .size-btn { flex: 0 0 auto; white-space: nowrap; }
    .size-btn .fin { display: none; }
  }
  .own { display: flex; flex-direction: column; gap: 6px; max-width: 720px; margin: 0 0 48px; padding: 18px 22px; border: 1.5px solid var(--ink, #111); background: var(--paper, #fff); color: inherit; text-decoration: none; line-height: 1.5; }
  .own-k { font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--red, #e11d26); }
  .own:hover u { text-decoration-thickness: 2px; }
  .card { flex: 1; display: grid; grid-template-rows: auto 1fr; gap: 18px; text-decoration: none; color: var(--ink); }
  .thumb { aspect-ratio: 8.5 / 11; display: flex; align-items: flex-end; justify-content: center; position: relative; }
  .thumb::after { content: ''; position: absolute; left: 8%; right: 8%; bottom: -10px; height: 18px; border-radius: 50%;
    background: radial-gradient(closest-side, rgba(60, 40, 20, 0.22), transparent); }
  .scale { position: relative; z-index: 1; flex: none; background: #fff;
    box-shadow: 0 1px 2px rgba(60, 40, 20, 0.12), 0 14px 28px -12px rgba(60, 40, 20, 0.45); transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease); }
  .card:hover .scale, .card:focus-visible .scale { transform: translateY(-6px) rotate(-0.4deg); box-shadow: 0 2px 4px rgba(60, 40, 20, 0.12), 0 26px 40px -16px rgba(60, 40, 20, 0.5); }
  .meta { display: flex; flex-direction: column; align-items: center; gap: 6px; text-align: center; }
  .no { color: #6b5d4d; }
  .desc { color: #4a3f33; font-size: 15px; max-width: 34ch; }
  .row { display: flex; justify-content: center; align-items: center; gap: 16px; margin-top: auto; padding-top: 10px; color: #4a3f33; }
  .go { background: var(--red); color: var(--white); padding: 10px 18px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.05em; font-size: 13px; border-radius: 2px; box-shadow: 0 8px 16px -10px rgba(237, 28, 36, 0.7); }
  .card:hover .go, .card:focus-visible .go { background: var(--red-ink); }
  .soon { border: 2px solid var(--ink); background: var(--white); padding: 28px; display: grid; gap: 14px; max-width: 760px; }
  .help { color: var(--ink-2); }
  .help a { color: var(--red-ink); font-weight: 700; }
  .more { background: var(--white); }
  .more .wrap { padding-top: 40px; padding-bottom: 56px; display: grid; gap: 18px; }
  .others { list-style: none; display: flex; flex-wrap: wrap; gap: 12px; }
  .others a { display: inline-flex; gap: 8px; padding: 12px 16px; border: 1.5px solid var(--ink); font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; font-size: 14px; text-decoration: none; }
  .others a:hover { background: var(--ink); color: var(--white); }
</style>

<script>
  import { shipStatus } from '../../lib/shipclock'
  // Same-day shipping countdown, updated every 30 seconds.
  const el = document.querySelector<HTMLElement>('[data-ship-clock]')
  const text = el?.querySelector<HTMLElement>('[data-ship-text]')
  const tick = () => {
    if (!el || !text) return
    const s = shipStatus({ rush: el.dataset.rush === '1' })
    text.textContent = s.text
    el.classList.add('is-on')
    el.classList.toggle('is-today', s.today)
  }
  tick()
  setInterval(tick, 30_000)
</script>

