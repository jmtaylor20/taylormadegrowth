---
import Base from '../../layouts/Base.astro'
import EditorApp from '../../editor/EditorApp'
import { ALL_TEMPLATES, TEMPLATES } from '../../editor/templates'
import { business } from '../../config/site'
import { getStartingPrice } from '../../lib/shopify'

export function getStaticPaths() {
  // Memorial add-ons get pages too, so staff can adjust one before printing.
  return ALL_TEMPLATES.map((t) => ({ params: { template: t.id }, props: { t } }))
}

const { template } = Astro.params
const { t } = Astro.props
const { name, description } = t
// Memorial add-ons are made from a program, never browsed: kept out of search.
const listed = TEMPLATES.some((x) => x.id === t.id)
const KIND: Record<string, string> = { 'funeral-programs': 'Funeral Program', 'christmas-cards': 'Christmas Card' }
const kind = KIND[t.category] ?? 'Printed Design'
const price = listed ? await getStartingPrice(t.shopifyHandle) : null
const title = listed ? `${name} ${kind} Template | ${business.name}` : `${name} | ${business.name}`
const pageDescription = `${description} ${t.sizeLabel}. Personalize it online, approve your proof, and we print it in Opelika, Alabama.`
const image = `/previews/${t.id}.jpg`
const schema = listed
  ? {
      '@context': 'https://schema.org',
      '@type': 'Product',
      name: `${name} ${kind}`,
      description: pageDescription,
      image: new URL(image, Astro.site).href,
      brand: { '@type': 'Brand', name: business.name },
      category: kind,
      url: new URL(`/design/${t.id}/`, Astro.site).href,
      ...(price
        ? { offers: { '@type': 'AggregateOffer', lowPrice: Number(price.amount).toFixed(2), priceCurrency: price.currencyCode, availability: 'https://schema.org/InStock', seller: { '@type': 'Organization', name: business.name } } }
        : {}),
    }
  : undefined
// Public Storefront token (read-only). The editor uses it in the browser for prices and the cart.
const domain = import.meta.env.SHOPIFY_STORE_DOMAIN
const token = import.meta.env.SHOPIFY_STOREFRONT_TOKEN
const shop = domain && token ? { domain, token } : null
---
<Base title={title} description={pageDescription} image={listed ? image : undefined} schema={schema} noindex={!listed}>
  <main id="main">
    <EditorApp client:only="react" templateId={template} shop={shop} backHref="/#products" phone={business.phone} phoneHref={business.phoneHref} />
    <noscript><p style="padding:40px">The designer needs JavaScript. To order, call us at {business.phone}.</p></noscript>
    {listed && (
      <section class="seo-summary">
        <h1>{name} {kind}</h1>
        <p>{pageDescription}</p>
        <img src={image} alt={`${name} ${kind.toLowerCase()} design`} width="900" height="900" loading="lazy" />
      </section>
    )}
  </main>
</Base>
<style>
  /* A plain description of the design for search engines and screen readers; the designer is what people see. */
  .seo-summary { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>
