---
import Base from '../layouts/Base.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { business, shop } from '../config/site'
---
<Base title="Thanks, we got your request | Kemp & Sons Printing">
  <Header />
  <main id="main" class="done">
    <div class="wrap inner">
      <p class="label">Request received</p>
      <h1 class="headline">Thank you. We'll be in touch.</h1>
      <p class="lede">Our team will review your project and reply within one business day, usually sooner. If it's urgent, call us at <a href={business.phoneHref}>{business.phone}</a>.</p>
      <div class="btn-row">
        <a class="btn btn-primary" href="/">Back to home</a>
        <a class="btn" href={shop.shopUrl}>Order online</a>
      </div>
    </div>
  </main>
  <Footer />
</Base>
<style>
  .done { min-height: 80vh; display: flex; align-items: center; padding: calc(var(--header-h) + 60px) 0 80px; }
  .inner { display: grid; gap: 22px; max-width: 760px; }
  .lede a { color: var(--burgundy); font-weight: 700; }
</style>
