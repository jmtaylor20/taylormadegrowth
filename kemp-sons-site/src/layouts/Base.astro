---
import '../styles/global.css'
import { business } from '../config/site'
import { tracking } from '../config/tracking'

interface Props {
  title?: string
  description?: string
  /** Keep this page out of search results (staff pages). */
  noindex?: boolean
  /** Share image (path or URL); defaults to the site's. */
  image?: string
  /** Extra structured data for search engines (a Product or ItemList). */
  schema?: Record<string, unknown>
}
const {
  title = `${business.name} | Opelika, Alabama`,
  noindex = false,
  image = 'https://kempandsons.com/og-image.png',
  schema,
  description = 'Order funeral programs and Christmas cards online, or get a quote on business cards, stickers, forms and other custom printing. Printed in Opelika, Alabama.',
} = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site)
// Staff pages, the funeral home portal and family links (their links carry private keys) are never tracked.
const tracked = tracking.enabled && !Astro.url.pathname.startsWith('/staff') && !Astro.url.pathname.startsWith('/portal') && !Astro.url.pathname.startsWith('/family')

// Structured data so Google shows the right business details.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': 'https://kempandsons.com/#business',
  name: business.name,
  url: 'https://kempandsons.com/',
  telephone: business.phone,
  email: business.email,
  image: 'https://kempandsons.com/og-image.png',
  logo: 'https://kempandsons.com/brand/kemp-sons-full-color.svg',
  address: {
    '@type': 'PostalAddress',
    streetAddress: business.address.street,
    addressLocality: business.address.city,
    addressRegion: business.address.state,
    postalCode: business.address.zip,
    addressCountry: 'US',
  },
  founder: undefined,
  sameAs: Object.values(business.social).filter(Boolean),
}
import { christmasSeason } from '../config/season'
---
<!doctype html>
<html lang="en">
  <head>
    <script is:inline define:vars={{ seasonEnds: christmasSeason.endsAt, orderBy: christmasSeason.orderBy }}>
      // Seasonal theme (src/config/season.ts): switches itself off after the end date.
      if (Date.now() < Date.parse(seasonEnds)) document.documentElement.classList.add('season-xmas')
      if (Date.now() < Date.parse(orderBy)) document.documentElement.classList.add('xmas-order-open')
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta name="theme-color" content="#103750" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    {image.endsWith('og-image.png') && <meta property="og:image:width" content="1200" />}
    {image.endsWith('og-image.png') && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <script is:inline>
      document.documentElement.classList.add('js')
    </script>
    {tracked && (
      <>
        <script
          is:inline
          define:vars={{ ga4: tracking.ga4, adsId: tracking.adsId, callLabel: tracking.callLabel, linkerDomains: tracking.linkerDomains, phone: business.phone }}
        >
          window.dataLayer = window.dataLayer || []
          window.gtag = function () { dataLayer.push(arguments) }
          // Consent Mode v2: denied for visitors in Europe (EEA, UK, Switzerland), granted elsewhere.
          // Decided from the browser's time zone: Google's own region-based default
          // was seen denying US visitors in testing, which would switch tracking off.
          var tz = ''
          try { tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '' } catch (e) {}
          var eu = /^(Europe\/|Atlantic\/(Reykjavik|Canary|Madeira|Azores|Faroe))/.test(tz)
          var c = eu ? 'denied' : 'granted'
          gtag('consent', 'default', { ad_storage: c, ad_user_data: c, ad_personalization: c, analytics_storage: c })
          gtag('js', new Date())
          gtag('set', 'linker', { domains: linkerDomains })
          // The shop's own kiosk counts as internal traffic, so it stays out of reports.
          var q = new URLSearchParams(location.search)
          if (q.get('kiosk') === '1' || location.pathname.indexOf('/in-store') === 0) {
            try { sessionStorage.setItem('kemp-kiosk', '1') } catch (e) {}
          }
          var kiosk = false
          try { kiosk = sessionStorage.getItem('kemp-kiosk') === '1' } catch (e) {}
          gtag('config', ga4, kiosk ? { traffic_type: 'internal' } : {})
          if (adsId) gtag('config', adsId, { allow_enhanced_conversions: true })
          // Website call tracking: shows a Google forwarding number to ad visitors.
          if (adsId && callLabel && !kiosk) gtag('config', adsId + '/' + callLabel, { phone_conversion_number: phone })
        </script>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${tracking.ga4}`}></script>
        <script>
          import { initTracking } from '../scripts/tracking'
          initTracking()
        </script>
      </>
    )}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
