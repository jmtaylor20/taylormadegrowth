---
import { Image } from 'astro:assets';
import footerLogo from '../assets/TMB_Horizontal_White_Logo.png';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container wide">
    <div class="footer-top">
      <div class="footer-brand">
        <Image src={footerLogo} alt="Taylormade Brands" class="footer-logo" width={280} densities={[1, 2]} loading="lazy" />
        <p>A growth partner for owner-led businesses — custom software, strategy, research, and reporting, built around how your business actually works.</p>
      </div>

      <div class="footer-col">
        <h5>Explore</h5>
        <a href="/services.html">Capabilities</a>
        <a href="/work.html">Work</a>
        <a href="/investment.html">Engagements</a>
        <a href="/about.html">About</a>
      </div>

      <div class="footer-col">
        <h5>Start</h5>
        <a href="/growth-assessment.html">Growth Assessment</a>
        <a href="/contact.html">Contact</a>
        <a href="/portfolio.html">Portfolio</a>
      </div>

      <div class="footer-col">
        <h5>Connect</h5>
        <a href="tel:+13343916641">334-391-6641</a>
        <a href="mailto:josh@taylormadegrowth.com">josh@taylormadegrowth.com</a>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {year} Taylormade Brands. Built for business growth.</p>
      <a href="/privacy.html">Privacy Policy</a>
    </div>
  </div>
</footer>
