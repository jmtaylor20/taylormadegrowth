---
import { Image } from 'astro:assets';
import logo from '../assets/TMB_Horizontal_Logo.png';

// Trimmed, consistent navigation (case studies now live under Work).
const links = [
  { href: '/index.html', label: 'Home' },
  { href: '/services.html', label: 'Services' },
  { href: '/investment.html', label: 'Investment' },
  { href: '/work.html', label: 'Work' },
  { href: '/about.html', label: 'About' },
  { href: '/contact.html', label: 'Contact' },
];

// Normalize current path so "/" and "/index.html" both light up Home.
const current = Astro.url.pathname.replace(/\/$/, '') || '/index.html';
const isActive = (href) =>
  href === current || (href === '/index.html' && current === '/');
---

<header class="site-header">
  <div class="container nav-wrap">
    <a href="/index.html" class="logo-link" aria-label="Taylormade Brands home">
      <Image src={logo} alt="Taylormade Brands logo" class="site-logo" width={360} densities={[1, 2]} loading="eager" />
    </a>

    <button class="mobile-menu-toggle" aria-label="Open menu" aria-expanded="false">☰</button>

    <nav class="site-nav">
      {links.map((l) => (
        <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
      <a href="/growth-assessment.html" class="nav-button">Start Assessment</a>
    </nav>
  </div>
</header>
