---
import { Image } from 'astro:assets';
import logo from '../assets/TMB_Horizontal_White_Logo.png';

const links = [
  { href: '/index.html', label: 'Home' },
  { href: '/services.html', label: 'Capabilities' },
  { href: '/work.html', label: 'Work' },
  { href: '/investment.html', label: 'Engagements' },
  { href: '/about.html', label: 'About' },
  { href: '/contact.html', label: 'Contact' },
];

const current = Astro.url.pathname.replace(/\/$/, '') || '/index.html';
const isActive = (href) => href === current || (href === '/index.html' && current === '/');
---

<header class="site-header">
  <div class="container wide nav-wrap">
    <a href="/index.html" class="logo-link" aria-label="Taylormade Brands home">
      <Image src={logo} alt="Taylormade Brands" class="site-logo" width={320} densities={[1, 2]} loading="eager" />
    </a>

    <button class="menu-toggle" aria-label="Open menu" aria-expanded="false">☰</button>

    <nav class="site-nav">
      {links.map((l) => (
        <a href={l.href} class="nav-item" aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
      <a href="/growth-assessment.html" class="btn btn-primary nav-cta">Start Here</a>
    </nav>
  </div>
</header>
