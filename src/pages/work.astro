---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import aoWebsite from '../assets/ao_website.png';
import aoGoogleProfile from '../assets/ao_google_profile.png';
import aoBusinessCard from '../assets/ao_business_card.png';
import aoReviewCard from '../assets/ao_review_card.png';
import wcWebsite from '../assets/wolfcreek_website.png';

import rhinoLogo from '../assets/clients/rhino-landworks.png';
import millersLogo from '../assets/clients/millers-backhoe.png';
import fordLogo from '../assets/clients/ford-paving.png';
import beehiveLogo from '../assets/clients/beehive-stars.png';

const clients = [
  { name: 'Rhino Landworks', logo: rhinoLogo, url: 'https://rhinolandwork.com', tagline: 'Land work done right.', desc: 'Land clearing, forestry mulching, grading, drainage, and gravel driveways across East Alabama.', work: ['Website', 'Branding'] },
  { name: "Miller's Backhoe Service", logo: millersLogo, url: 'https://millerbackhoe.com', tagline: 'One call. Serious capability.', desc: 'Septic systems, trenching, drainage, and excavation out of Notasulga, Alabama.', work: ['Website', 'Brand identity'] },
  { name: 'Ford Paving & Sealing', logo: fordLogo, url: 'https://fordpaving.com', tagline: 'Built smooth. Finished sharp.', desc: 'Asphalt paving, sealcoating, striping, driveways, and parking lots across Central Alabama.', work: ['Website', 'Branding'] },
  { name: 'Beehive Stars Baseball', logo: beehiveLogo, url: 'https://beehivestars.com', tagline: 'Built for the Next Level.', desc: 'Travel baseball and softball with player development, tryouts, and an online team registration platform.', work: ['Website', 'Branding', 'Registration app'] },
];

const platforms = [
  { tag: 'Field operations app', title: 'A&O Tree Service', body: 'A mobile-first app the crew runs the whole business on — fast estimate intake, an estimating pipeline, day-by-day crew scheduling, route-optimized estimate runs, job completion and payments, plus a monthly analytics suite. Leads flow in from email automatically and job PDFs archive themselves.', points: ['Estimating & pipeline', 'Crew scheduling + Mapbox routing', 'Payments & monthly reporting'] },
  { tag: 'Club platform', title: 'Beehive Stars Baseball', body: 'A full platform for a travel ball organization — a scheduling calendar with coach logins and admin approvals, data-driven team pages with rosters and announcements, online tryout registration with a scoring app and printable evaluation binder, digital medical-release waivers, payments, and sponsorships.', points: ['Calendar + coach/admin roles', 'Tryout registration & scoring', 'Digital medical-release waivers'] },
  { tag: 'Operations & reporting', title: 'Taylormade platform', body: 'The system I run the business on and report from — sales pipeline, clients, projects, invoicing and MRR, proposals, and renewals, with an automated monthly client-report generator behind every partnership.', points: ['Pipeline, invoicing & MRR', 'Proposals & renewals', 'Automated monthly reports'] },
];
---

<Base
  title="Work | Taylormade Brands"
  description="Selected work from Taylormade Brands — custom web apps and platforms, client websites, branding, Google growth, and measurable results for owner-led businesses."
>
  <main>
    <!-- HERO -->
    <section class="ink page-hero grid-bg glow-gold">
      <div class="container wide">
        <p class="label">Selected work</p>
        <h1 class="display" style="max-width: 16ch;">Systems, software, and brands built to grow real businesses.</h1>
        <p class="lead muted" style="max-width: 62ch;">
          Websites and branding that make owner-led companies look sharper and get found — and the custom
          software and reporting that turn them into a growth system.
        </p>
        <div class="btn-row mt-m">
          <a href="/ao-case-study.html" class="btn btn-primary">Read the case study <span class="arrow">→</span></a>
          <a href="/growth-assessment.html" class="btn btn-ghost">Start an assessment</a>
        </div>
      </div>
    </section>

    <!-- CLIENTS -->
    <section class="paper section">
      <div class="container wide">
        <div class="head">
          <p class="label">Recent clients</p>
          <h2>New brands, new websites, and growth systems.</h2>
          <p>Built for real companies across Alabama — with more than a website behind each one.</p>
        </div>

        <div class="grid-2 client-grid">
          {clients.map((c) => (
            <a class="card client-card" href={c.url} target="_blank" rel="noopener">
              <div class="client-top">
                <span class="client-plate"><Image src={c.logo} alt={`${c.name} logo`} width={260} /></span>
                <span class="text-link client-visit">Visit site <span class="arrow">→</span></span>
              </div>
              <h3>{c.name}</h3>
              <p class="client-tag gold">{c.tagline}</p>
              <p class="muted">{c.desc}</p>
              <div class="tags mt-m">{c.work.map((w) => <span class="tag">{w}</span>)}</div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- PLATFORMS / SOFTWARE -->
    <section class="ink section">
      <div class="container wide">
        <div class="head">
          <p class="label">Platforms &amp; software</p>
          <h2>Custom web apps behind the marketing.</h2>
          <p>The work that turns a marketing relationship into a growth partnership — software and reporting built for how each business runs.</p>
        </div>
        <div class="grid-3">
          {platforms.map((p) => (
            <article class="card platform-card reveal">
              <span class="tag">{p.tag}</span>
              <h3 class="mt-s">{p.title}</h3>
              <p class="muted">{p.body}</p>
              <ul class="feature-list mt-m">{p.points.map((pt) => <li>{pt}</li>)}</ul>
            </article>
          ))}
        </div>
        <p class="disclaimer mt-l">Some platforms are internal or client-private and are described rather than shown to protect client data.</p>
      </div>
    </section>

    <!-- RESULTS -->
    <section class="ink-2 section">
      <div class="container wide">
        <div class="head center mx-auto">
          <p class="label center mx-auto">The impact</p>
          <h2>Built to bring in real business.</h2>
          <p class="mx-auto">I don't just build things that look good. I build them to generate leads and revenue — and that has added up to hundreds of thousands of dollars in new work.</p>
        </div>
        <div class="grid-3">
          <div class="card center rstat reveal"><span class="stat-num">$300K+</span><p class="stat-label">in new business landed by local clients after launching their growth systems</p></div>
          <div class="card center rstat reveal"><span class="stat-num">Booked out</span><p class="stat-label">demand so strong clients have hired new employees to keep up</p></div>
          <div class="card center rstat reveal"><span class="stat-num">Search-led</span><p class="stat-label">for some clients, almost every new customer now comes straight from their website and Google</p></div>
        </div>
        <p class="results-quote center mx-auto">“One client called just to say thank you. Another told me their office is tired of answering the phone.”</p>
        <p class="disclaimer center mx-auto">Results reflect outcomes reported by clients and vary by business. Individual results are not guaranteed.</p>
      </div>
    </section>

    <!-- FEATURED CASE STUDIES -->
    <section class="paper section">
      <div class="container wide">
        <div class="head">
          <p class="label">Case studies</p>
          <h2>The full story behind the work.</h2>
        </div>
        <div class="grid-2">
          <a href="/ao-case-study.html" class="card case-card reveal">
            <div class="case-shot"><Image src={aoWebsite} alt="A&O Tree Service website" width={900} /></div>
            <div class="case-body">
              <span class="tag">Featured project</span>
              <h3 class="mt-s">A&amp;O Tree Service</h3>
              <p class="muted">A complete local growth project — website, branding, Google presence, ads, review system, and lead capture built to work as one.</p>
              <span class="text-link mt-s">Read the case study <span class="arrow">→</span></span>
            </div>
          </a>
          <a href="/wolf-creek-growth-project.html" class="card case-card reveal">
            <div class="case-shot"><Image src={wcWebsite} alt="Wolf Creek Farms website" width={900} /></div>
            <div class="case-body">
              <span class="tag">Growth project</span>
              <h3 class="mt-s">Wolf Creek Farms</h3>
              <p class="muted">A full rebrand and new website for a respected land-management company — a stronger identity and a foundation built for growth.</p>
              <span class="text-link mt-s">See the project <span class="arrow">→</span></span>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- BRAND GALLERY -->
    <section class="ink section">
      <div class="container wide">
        <div class="head">
          <p class="label">Brand &amp; print</p>
          <h2>Customer touchpoints that build confidence.</h2>
        </div>
        <div class="grid-3">
          <figure class="gallery-item reveal"><Image src={aoGoogleProfile} alt="Google Business Profile" width={720} /><figcaption>Google Business Profile</figcaption></figure>
          <figure class="gallery-item reveal"><Image src={aoBusinessCard} alt="Business card" width={720} /><figcaption>Business card</figcaption></figure>
          <figure class="gallery-item reveal"><Image src={aoReviewCard} alt="QR review card" width={720} /><figcaption>QR review card</figcaption></figure>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="ink-2 section">
      <div class="container narrow center">
        <p class="label center mx-auto">Start here</p>
        <h2 class="mt-s">Want your business to look sharper and run better?</h2>
        <p class="lead muted mt-s mx-auto" style="max-width:56ch;">Start with the growth assessment. I'll review your presence, operations, and lead flow, and show you where to start.</p>
        <a href="/growth-assessment.html" class="btn btn-primary mt-m">Take the assessment <span class="arrow">→</span></a>
      </div>
    </section>
  </main>

  <style>
    .client-grid { margin-top: 8px; }
    .client-card { display: flex; flex-direction: column; }
    .client-top { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 20px; }
    .client-plate { display: inline-flex; align-items: center; height: 56px; padding: 0 20px; background: var(--paper); border: 1px solid var(--line-l); border-radius: 10px; }
    .client-plate :global(img) { height: 34px; width: auto; object-fit: contain; }
    .client-visit { font-size: 0.9rem; }
    .client-tag { font-weight: 600; font-size: 0.95rem; margin: 6px 0 10px; }
    .platform-card { display: flex; flex-direction: column; }
    .rstat { display: flex; flex-direction: column; align-items: center; gap: 8px; }
    .results-quote { font-family: var(--font-display); font-size: clamp(1.3rem, 2.4vw, 1.9rem); line-height: 1.4; max-width: 24ch; margin: 44px auto 0; color: var(--d-text); }
    .case-card { padding: 0; overflow: hidden; }
    .case-shot { aspect-ratio: 16 / 10; overflow: hidden; border-bottom: 1px solid var(--line-l); }
    .case-shot :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: top; }
    .case-body { padding: 28px 30px 32px; }
    .gallery-item { border: 1px solid var(--line-d); border-radius: 14px; overflow: hidden; background: var(--ink-2); }
    .gallery-item :global(img) { width: 100%; height: 240px; object-fit: cover; object-position: top; }
    .gallery-item figcaption { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.06em; color: var(--d-muted); padding: 14px 18px; border-top: 1px solid var(--line-d); }
    @media (max-width: 900px) { .grid-2, .grid-3 { grid-template-columns: 1fr; } }
  </style>
</Base>
