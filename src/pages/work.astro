---
import Base from '../layouts/Base.astro';
import { Image, getImage } from 'astro:assets';
import heroSrc from '../assets/ao_work_photo.png';
import aoWebsite from '../assets/ao_website.png';
import aoContact from '../assets/ao_contact_webpage.png';
import aoServices from '../assets/ao_services_webpage.png';
import aoMobile from '../assets/ao_mobile_website.png';
import aoGoogleProfile from '../assets/ao_google_profile.png';
import aoGoogleAds from '../assets/ao_google_ads.png';
import aoBusinessCard from '../assets/ao_business_card.png';
import aoReviewCard from '../assets/ao_review_card.png';
import aoEstimate from '../assets/ao_estimate_sheet.png';
import aoWorkPhoto from '../assets/ao_work_photo.png';

const hero = await getImage({ src: heroSrc, format: 'webp', width: 1600 });
---

<Base
  title="Work | Taylormade Brands"
  description="View Taylormade Brands work examples including websites, branding, Google Business Profile support, Google Ads, print materials, and growth systems."
>
  <main>
    <section class="work-hero improved-work-hero" style={`--hero-bg: url(${hero.src})`}>
      <div class="container work-hero-grid">
        <div>
          <p class="eyebrow">Selected Work</p>
          <h1>Marketing assets built to make local businesses look sharper and get found.</h1>
          <p>
            Websites, Google tools, print materials, review systems, and brand touchpoints built around real business growth.
          </p>

          <div class="button-row">
            <a href="/ao-case-study.html" class="button primary">View Case Study</a>
            <a href="/growth-assessment.html" class="button secondary">Start Assessment</a>
          </div>
        </div>

        <div class="work-hero-card">
          <h3>A&amp;O Tree Service</h3>
          <p>A complete local growth project.</p>
          <ul>
            <li>Website</li>
            <li>Google Business Profile</li>
            <li>Google Ads</li>
            <li>Review System</li>
            <li>Print Materials</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section work-category-section">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow dark">Work Categories</p>
          <h2>Everything works better when it works together.</h2>
        </div>

        <div class="work-category-grid">
          <div class="work-category-card">
            <span>01</span>
            <h3>Websites</h3>
            <p>Lead-focused pages built around services, trust, and contact.</p>
          </div>

          <div class="work-category-card">
            <span>02</span>
            <h3>Google Growth</h3>
            <p>Google Business Profile and ads support for local search visibility.</p>
          </div>

          <div class="work-category-card">
            <span>03</span>
            <h3>Branding</h3>
            <p>Business cards, review cards, estimates, and customer materials.</p>
          </div>

          <div class="work-category-card">
            <span>04</span>
            <h3>Growth Systems</h3>
            <p>Simple marketing pieces that support leads, reviews, and follow-up.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section work-section">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow dark">Websites</p>
          <h2>Built to turn visitors into leads.</h2>
        </div>

        <div class="work-grid">
          <article class="work-card large">
            <Image src={aoWebsite} alt="A&O Tree Service website homepage" width={1100} />
            <div class="work-card-content">
              <h3>A&amp;O Website Homepage</h3>
              <p>Service-focused homepage with clear calls to action and local credibility.</p>
            </div>
          </article>

          <article class="work-card">
            <Image src={aoContact} alt="A&O Tree Service contact page" width={720} />
            <div class="work-card-content">
              <h3>Lead Form Page</h3>
              <p>Simple form built to capture service inquiries.</p>
            </div>
          </article>

          <article class="work-card">
            <Image src={aoServices} alt="A&O Tree Service services page" width={720} />
            <div class="work-card-content">
              <h3>Services Page</h3>
              <p>Clear service structure for customers comparing options.</p>
            </div>
          </article>

          <article class="work-card">
            <Image src={aoMobile} alt="A&O Tree Service mobile website" width={720} />
            <div class="work-card-content">
              <h3>Mobile Layout</h3>
              <p>Built for customers searching from their phones.</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="section work-section light-work">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow dark">Google Growth</p>
          <h2>Visibility and trust where customers search first.</h2>
        </div>

        <div class="work-grid two-column">
          <article class="work-card">
            <Image src={aoGoogleProfile} alt="A&O Tree Service Google Business Profile" width={720} />
            <div class="work-card-content">
              <h3>Google Business Profile</h3>
              <p>Profile support to strengthen local visibility and trust.</p>
            </div>
          </article>

          <article class="work-card">
            <Image src={aoGoogleAds} alt="A&O Tree Service Google Ads dashboard" width={720} />
            <div class="work-card-content">
              <h3>Google Ads</h3>
              <p>Local search campaign support focused on service leads.</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="section work-section">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow dark">Branding &amp; Print</p>
          <h2>Customer touchpoints that build confidence.</h2>
        </div>

        <div class="work-grid three-column">
          <article class="work-card">
            <Image src={aoBusinessCard} alt="A&O Tree Service business card" width={600} />
            <div class="work-card-content">
              <h3>Business Card</h3>
              <p>Clean contact piece for referrals and customer conversations.</p>
            </div>
          </article>

          <article class="work-card">
            <Image src={aoReviewCard} alt="A&O Tree Service review card" width={600} />
            <div class="work-card-content">
              <h3>Review Card</h3>
              <p>QR-based review tool to help build Google trust.</p>
            </div>
          </article>

          <article class="work-card">
            <Image src={aoEstimate} alt="A&O Tree Service estimate sheet" width={600} />
            <div class="work-card-content">
              <h3>Estimate Sheet</h3>
              <p>Professional quoting material that reinforces credibility.</p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="section featured-work">
      <div class="container featured-work-grid">
        <div>
          <p class="eyebrow">Featured Project</p>
          <h2>A&amp;O Tree Service Case Study</h2>
          <p>
            A complete local business growth project covering website launch,
            Google presence, Google Ads, print materials, review generation,
            and lead capture.
          </p>
          <a href="/ao-case-study.html" class="button primary">View Full Case Study</a>
        </div>

        <div class="featured-image-wrap">
          <Image src={aoWorkPhoto} alt="A&O Tree Service work example" width={900} />
        </div>
      </div>
    </section>

    <section class="section cta-section">
      <div class="container narrow">
        <p class="eyebrow">Start Here</p>
        <h2>Want your business to look sharper and get found?</h2>
        <p>
          Start with the growth assessment. I'll review your website, Google presence,
          branding, reviews, and lead flow.
        </p>
        <a href="/growth-assessment.html" class="button primary">Start Assessment</a>
      </div>
    </section>
  </main>
</Base>
