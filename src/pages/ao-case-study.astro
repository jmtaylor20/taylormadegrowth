---
import Base from '../layouts/Base.astro';
import { Image, getImage } from 'astro:assets';
import heroSrc from '../assets/ao_work_photo.png';
import aoWebsite from '../assets/ao_website.png';
import aoGoogleProfile from '../assets/ao_google_profile.png';
import aoGoogleAds from '../assets/ao_google_ads.png';
import aoBusinessCard from '../assets/ao_business_card.png';
import aoReviewCard from '../assets/ao_review_card.png';

const hero = await getImage({ src: heroSrc, format: 'webp', width: 1600 });
---

<Base
  title="A&O Tree Service Growth Project | Taylormade Brands"
  description="See how Taylormade Brands helped A&O Tree Service improve its website, branding, Google presence, ads, reviews, and lead generation system."
>
  <main>
    <section class="case-hero" style={`--hero-bg: url(${hero.src})`}>
      <div class="container case-hero-grid">
        <div>
          <p class="eyebrow">Featured Case Study</p>
          <h1>A&amp;O Tree Service</h1>
          <p class="hero-text">
            From a strong local tree service company to a sharper online presence,
            stronger branding, and a clearer lead generation system.
          </p>

          <div class="button-row">
            <a href="https://aotrees.com" class="button primary" target="_blank" rel="noopener">View Website</a>
            <a href="/growth-assessment.html" class="button secondary">Start Assessment</a>
          </div>
        </div>

        <div class="case-hero-card">
          <h3>A&amp;O Tree Service</h3>

          <p class="case-location">Auburn, Alabama</p>

          <ul class="case-summary-list">
            <li>Website Launch</li>
            <li>Google Ads</li>
            <li>Google Business Profile</li>
            <li>Review Generation System</li>
            <li>Business Cards &amp; Print Materials</li>
            <li>Lead Generation Strategy</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section case-summary-section">
      <div class="container case-summary-grid">
        <div>
          <p class="eyebrow dark">The Challenge</p>
          <h2>A&amp;O was doing quality work, but the online presence needed to catch up.</h2>
          <p>
            The business had strong service, real local trust, and growth potential.
            The problem was that customers needed a clearer way to find them, trust them,
            and request service online.
          </p>
        </div>

        <div class="challenge-list">
          <h3>Key Challenges</h3>
          <ul>
            <li>Limited online visibility</li>
            <li>No modern lead-focused website</li>
            <li>No clear review generation process</li>
            <li>Branding needed more consistency</li>
            <li>No structured Google Ads strategy</li>
            <li>Customer follow-up needed a system</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section build-section">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow dark">What We Built</p>
          <h2>A complete local growth foundation.</h2>
        </div>

        <div class="case-card-grid">
          <div class="case-service-card">
            <span>01</span>
            <h3>Website</h3>
            <p>Professional website, mobile layout, service structure, and estimate request form.</p>
          </div>

          <div class="case-service-card">
            <span>02</span>
            <h3>Branding</h3>
            <p>Business cards, review cards, print materials, and consistent visual presentation.</p>
          </div>

          <div class="case-service-card">
            <span>03</span>
            <h3>Google Profile</h3>
            <p>Profile support, service updates, photos, and review strategy.</p>
          </div>

          <div class="case-service-card">
            <span>04</span>
            <h3>Google Ads</h3>
            <p>Search campaign structure, local targeting, lead generation, and tracking.</p>
          </div>

          <div class="case-service-card">
            <span>05</span>
            <h3>Review System</h3>
            <p>QR review card and simple process for asking satisfied customers for reviews.</p>
          </div>

          <div class="case-service-card">
            <span>06</span>
            <h3>Growth System</h3>
            <p>Marketing roadmap, lead tracking, customer touchpoints, and next-step planning.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section visual-section">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow dark">Project Gallery</p>
          <h2>Real assets built for a real local business.</h2>
        </div>

        <div class="portfolio-grid">
          <div class="portfolio-item large">
            <Image src={aoWebsite} alt="A&O Tree Service website" width={1100} />
            <div>
              <h3>Website</h3>
              <p>Service-focused website with lead form and clear calls to action.</p>
            </div>
          </div>

          <div class="portfolio-item">
            <Image src={aoGoogleProfile} alt="A&O Tree Service Google Business Profile" width={720} />
            <div>
              <h3>Google Profile</h3>
              <p>Stronger local visibility and customer trust.</p>
            </div>
          </div>

          <div class="portfolio-item">
            <Image src={aoGoogleAds} alt="A&O Tree Service Google Ads" width={720} />
            <div>
              <h3>Google Ads</h3>
              <p>Local search campaign built to capture demand.</p>
            </div>
          </div>

          <div class="portfolio-item">
            <Image src={aoBusinessCard} alt="A&O Tree Service business card" width={720} />
            <div>
              <h3>Business Card</h3>
              <p>Clean printed material for customer touchpoints.</p>
            </div>
          </div>

          <div class="portfolio-item">
            <Image src={aoReviewCard} alt="A&O Tree Service review card" width={720} />
            <div>
              <h3>Review Card</h3>
              <p>QR-based review tool to build Google trust.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section results-section">
      <div class="container results-grid">
        <div>
          <p class="eyebrow">Early Results</p>
          <h2>Better visibility. Better trust. Better lead flow.</h2>
          <p>
            Since launch, A&amp;O has a stronger foundation for customer discovery,
            online credibility, and lead generation.
          </p>
        </div>

        <div class="results-list">
          <div>Increased lead activity</div>
          <div>Expanded online visibility</div>
          <div>New customer inquiries</div>
          <div>Improved professional image</div>
          <div>Stronger review process</div>
          <div>Better marketing foundation</div>
        </div>
      </div>
    </section>

    <section class="section lesson-section">
      <div class="container narrow">
        <p class="eyebrow dark">The Biggest Lesson</p>
        <h2>Most local businesses do not have a work problem. They have a visibility problem.</h2>
        <p>
          When customers can find you, trust you, and contact you without confusion,
          growth becomes much easier.
        </p>
      </div>
    </section>

    <section class="section cta-section">
      <div class="container narrow">
        <p class="eyebrow">Start Here</p>
        <h2>Want a growth system like this for your business?</h2>
        <p>
          Start with the client growth assessment. I'll review where you are,
          what is missing, and what should happen first.
        </p>
        <a href="/growth-assessment.html" class="button primary">Start Assessment</a>
      </div>
    </section>
  </main>
</Base>
