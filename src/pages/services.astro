---
import Base from '../layouts/Base.astro';
import { Image, getImage } from 'astro:assets';
import heroSrc from '../assets/TMB_Hero.png';
import growthSystem from '../assets/growth_system.png';
import aoBusinessCard from '../assets/ao_business_card.png';
import aoWebsite from '../assets/ao_website.png';
import aoGoogleProfile from '../assets/ao_google_profile.png';
import aoReviewCard from '../assets/ao_review_card.png';
import aoWorkPhoto from '../assets/ao_work_photo.png';

const hero = await getImage({ src: heroSrc, format: 'webp', width: 1600 });
---

<Base
  title="Services | Taylormade Brands"
  description="Taylormade Brands helps local businesses look professional, get found, generate leads, and grow through websites, branding, Google tools, and marketing systems."
>
  <main>
    <section class="services-hero" style={`--hero-bg: url(${hero.src})`}>
      <div class="container services-hero-grid">
        <div>
          <p class="eyebrow">Services</p>
          <h1>The systems local businesses need to look better, get found, and grow.</h1>
          <p>
            Most businesses do not need random marketing. They need the right pieces working together:
            branding, website, Google visibility, reviews, lead capture, and follow-up.
          </p>

          <div class="button-row">
            <a href="/growth-assessment.html" class="button primary">Start Assessment</a>
            <a href="/work.html" class="button secondary">View Work</a>
          </div>
        </div>

        <div class="services-hero-card">
          <h3>Core Focus</h3>
          <ul>
            <li>Look Professional</li>
            <li>Get Found</li>
            <li>Generate Leads</li>
            <li>Grow Consistently</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section growth-system-section">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow dark">The Growth System</p>
          <h2>Every piece should support the next one.</h2>
          <p>
            A good website matters. So does branding. So does Google. The real power comes when those pieces work together.
          </p>
        </div>

        <div class="growth-system-image-wrap">
          <Image src={growthSystem} alt="Local business growth system diagram" width={1100} />
        </div>
      </div>
    </section>

    <section class="section services-category-section">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow dark">How I Help</p>
          <h2>Services built around outcomes, not random deliverables.</h2>
        </div>

        <div class="services-grid">
          <article class="service-detail-card">
            <Image src={aoBusinessCard} alt="Branding and business card example" width={720} />
            <div>
              <span>01</span>
              <h3>Branding &amp; Print Materials</h3>
              <p>
                Build trust before the customer ever calls. This includes logos, brand kits,
                business cards, review cards, estimate sheets, yard signs, and other customer touchpoints.
              </p>
              <ul>
                <li>Logo design and brand kit</li>
                <li>Business cards and review cards</li>
                <li>Estimate sheets and printed materials</li>
                <li>Signs, flyers, and branded customer pieces</li>
              </ul>
            </div>
          </article>

          <article class="service-detail-card">
            <Image src={aoWebsite} alt="Website design example" width={720} />
            <div>
              <span>02</span>
              <h3>Websites</h3>
              <p>
                A website should explain what you do, build trust, and make it easy for customers
                to contact you. Pretty is not enough. It has to work.
              </p>
              <ul>
                <li>Service business websites</li>
                <li>Mobile-friendly design</li>
                <li>Lead capture forms</li>
                <li>Service pages and trust-building content</li>
              </ul>
            </div>
          </article>

          <article class="service-detail-card">
            <Image src={aoGoogleProfile} alt="Google Business Profile example" width={720} />
            <div>
              <span>03</span>
              <h3>Google Growth</h3>
              <p>
                Customers search Google when they are ready to act. Your profile, reviews,
                photos, service pages, and ads need to support that moment.
              </p>
              <ul>
                <li>Google Business Profile support</li>
                <li>Review generation systems</li>
                <li>Google Ads setup and support</li>
                <li>Local visibility improvements</li>
              </ul>
            </div>
          </article>

          <article class="service-detail-card">
            <Image src={aoReviewCard} alt="Review generation system example" width={720} />
            <div>
              <span>04</span>
              <h3>Marketing &amp; Growth Systems</h3>
              <p>
                Growth gets easier when leads, reviews, follow-up, and customer touchpoints are organized.
                I help build the system behind the marketing.
              </p>
              <ul>
                <li>Lead tracking and follow-up</li>
                <li>Referral and review systems</li>
                <li>Seasonal campaign planning</li>
                <li>Growth consulting and ongoing management</li>
              </ul>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="section business-needs-section">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow dark">Where You Fit</p>
          <h2>Different businesses need different starting points.</h2>
        </div>

        <div class="needs-grid">
          <div class="need-card">
            <h3>New Business</h3>
            <p>You need to look legitimate fast.</p>
            <ul>
              <li>Logo and brand kit</li>
              <li>Website</li>
              <li>Google Business Profile</li>
              <li>Basic print materials</li>
            </ul>
          </div>

          <div class="need-card">
            <h3>Established Business</h3>
            <p>You have customers, but your online presence needs to catch up.</p>
            <ul>
              <li>Website refresh</li>
              <li>Review system</li>
              <li>Google profile cleanup</li>
              <li>Brand consistency</li>
            </ul>
          </div>

          <div class="need-card">
            <h3>Growing Business</h3>
            <p>You need a repeatable system, not one-off marketing.</p>
            <ul>
              <li>Google Ads</li>
              <li>Lead tracking</li>
              <li>Follow-up process</li>
              <li>Ongoing marketing support</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="section pathways-section">
      <div class="container">
        <div class="section-heading">
          <p class="eyebrow dark">Recommended Pathways</p>
          <h2>Pick the starting point that matches the problem.</h2>
        </div>

        <div class="pathway-grid">
          <div class="pathway-card">
            <span>Foundation</span>
            <h3>Get Professional</h3>
            <p>Branding, website, Google profile, and basic customer materials.</p>
          </div>

          <div class="pathway-card featured-pathway">
            <span>Growth</span>
            <h3>Get Found</h3>
            <p>Website improvements, Google visibility, review system, and local search support.</p>
          </div>

          <div class="pathway-card">
            <span>Momentum</span>
            <h3>Scale What Works</h3>
            <p>Google Ads, lead tracking, follow-up systems, and ongoing growth support.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section service-proof-section">
      <div class="container service-proof-grid">
        <div>
          <p class="eyebrow">Proof</p>
          <h2>A&amp;O Tree Service shows how the pieces work together.</h2>
          <p>
            Website launch, Google Business Profile support, Google Ads, print materials,
            review generation, and lead capture all worked together as one growth foundation.
          </p>
          <a href="/ao-case-study.html" class="button primary">View Case Study</a>
        </div>

        <div class="service-proof-image">
          <Image src={aoWorkPhoto} alt="A&O Tree Service work photo" width={900} />
        </div>
      </div>
    </section>

    <section class="section faq-section">
      <div class="container narrow">
        <div class="section-heading">
          <p class="eyebrow dark">Common Questions</p>
          <h2>Questions business owners usually ask first.</h2>
        </div>

        <div class="faq-list">
          <details>
            <summary>Do I need a website?</summary>
            <p>
              If customers search for your service online, yes. Your website gives people a clear place
              to learn, trust, and contact you.
            </p>
          </details>

          <details>
            <summary>Do you manage everything?</summary>
            <p>
              I can help with strategy, setup, design, launch, and ongoing management depending on what the business needs.
            </p>
          </details>

          <details>
            <summary>Should I run Google Ads?</summary>
            <p>
              Google Ads work best when your website, Google profile, reviews, and lead process are ready first.
            </p>
          </details>

          <details>
            <summary>Do you only work with tree services?</summary>
            <p>
              No. The system works for many local businesses, especially service companies, churches, team stores,
              contractors, and community-based organizations.
            </p>
          </details>
        </div>
      </div>
    </section>

    <section class="section cta-section">
      <div class="container narrow">
        <p class="eyebrow">Start Here</p>
        <h2>Ready to see where your business stands?</h2>
        <p>
          Take the growth assessment and I'll review your current website, Google presence,
          branding, reviews, and lead flow.
        </p>
        <a href="/growth-assessment.html" class="button primary">Start Assessment</a>
      </div>
    </section>
  </main>
</Base>
