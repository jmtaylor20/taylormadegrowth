---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import aoWebsite from '../assets/ao_website.png';
---

<Base
  title="Capabilities | Taylormade Brands"
  description="Taylormade Brands builds custom software, growth strategy, research and reporting, and marketing systems for owner-led businesses — one partner across the whole stack."
>
  <main>
    <!-- HERO -->
    <section class="ink page-hero grid-bg glow-gold">
      <div class="container wide">
        <div class="hero-split">
          <div>
            <p class="label">Capabilities</p>
            <h1 class="display">One partner across the whole stack.</h1>
            <p class="lead muted">
              Most businesses don't need more vendors. They need one partner who can build the software,
              set the strategy, do the research, and run the marketing — so every piece works together
              instead of pulling in different directions.
            </p>
            <div class="btn-row mt-m">
              <a href="/growth-assessment.html" class="btn btn-primary">Start with an assessment <span class="arrow">→</span></a>
              <a href="/investment.html" class="btn btn-ghost">See engagements</a>
            </div>
          </div>

          <div class="cap-index card reveal">
            <p class="label plain">Four disciplines</p>
            <ol class="cap-list">
              <li><a href="#software"><span class="index">01</span> Custom Software &amp; Web Apps</a></li>
              <li><a href="#strategy"><span class="index">02</span> Growth Strategy</a></li>
              <li><a href="#research"><span class="index">03</span> Research &amp; Reporting</a></li>
              <li><a href="#marketing"><span class="index">04</span> Marketing, Brand &amp; Web</a></li>
            </ol>
          </div>
        </div>
      </div>
    </section>

    <!-- 01 SOFTWARE -->
    <section class="paper section" id="software">
      <div class="container wide split lean">
        <div>
          <p class="label">01 — Custom Software &amp; Web Apps</p>
          <h2>Software built around your business — not the other way around.</h2>
          <p class="lead muted mt-s">
            Off-the-shelf tools force you to change how you work. I build web apps and platforms that
            fit the way your business already runs, then remove the busywork around it.
          </p>
          <ul class="feature-list mt-m">
            <li><strong>Client &amp; customer portals</strong> — logins, dashboards, and self-serve tools for the people you work with.</li>
            <li><strong>Registration &amp; booking systems</strong> — online sign-ups, rosters, and scheduling that run themselves.</li>
            <li><strong>Internal operations tools</strong> — CRM, pipeline, invoicing, and workflow apps that replace spreadsheets.</li>
            <li><strong>Dashboards &amp; automation</strong> — live numbers and automated steps that save hours every week.</li>
          </ul>
        </div>
        <div class="mock reveal">
          <div class="mock-head"><span class="rdot active"></span> operations · pipeline</div>
          <div class="mini-cols">
            <div><span class="mc-label">New</span><span class="mc-chip">Estimate request</span><span class="mc-chip">Referral</span></div>
            <div><span class="mc-label">Building</span><span class="mc-chip gold">Client portal</span><span class="mc-chip">Website</span></div>
            <div><span class="mc-label">Live</span><span class="mc-chip">Reg. system</span><span class="mc-chip">Reporting</span></div>
          </div>
          <div class="mock-rows mt-m">
            <div class="mock-row"><span>Active clients</span><b>12</b></div>
            <div class="mock-row"><span>Open invoices</span><b class="gold">$8,400</b></div>
            <div class="mock-row"><span>Tasks this week</span><b>23</b></div>
          </div>
        </div>
      </div>
    </section>

    <!-- 02 STRATEGY -->
    <section class="ink section" id="strategy">
      <div class="container wide split lean">
        <div class="strat-visual reveal">
          <div class="roadmap-mock">
            <div class="rm-step"><span class="index">Now</span><h4>Fix what's leaking</h4><p class="muted">Close the obvious gaps — trust, visibility, follow-up.</p></div>
            <div class="rm-step"><span class="index">Next</span><h4>Build the system</h4><p class="muted">Software, brand, and lead flow working together.</p></div>
            <div class="rm-step"><span class="index">Later</span><h4>Compound it</h4><p class="muted">Reporting, iteration, and scale as a partnership.</p></div>
          </div>
        </div>
        <div>
          <p class="label">02 — Growth Strategy</p>
          <h2>A clear plan, and a partner to run it with.</h2>
          <p class="lead muted mt-s">
            Strategy isn't a slide deck that sits in a drawer. It's a prioritized plan for what to fix
            first, what to build next, and how to tell it's working — and someone in the business with you
            to keep it moving.
          </p>
          <ul class="feature-list mt-m">
            <li><strong>Growth roadmap</strong> — what to do now, next, and later, ranked by impact.</li>
            <li><strong>Systems thinking</strong> — connecting operations, marketing, and follow-up into one flow.</li>
            <li><strong>Ongoing partnership</strong> — regular working sessions, not a one-time engagement.</li>
            <li><strong>Owner's-seat advice</strong> — practical calls made with your goals and margins in mind.</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- 03 RESEARCH & REPORTING -->
    <section class="paper section" id="research">
      <div class="container wide split lean">
        <div>
          <p class="label">03 — Research &amp; Reporting</p>
          <h2>Decisions made on evidence, not guesswork.</h2>
          <p class="lead muted mt-s">
            I dig into the market, the competition, and your own numbers — then turn it into plain-language
            reporting you can actually act on. Every engagement is measured, so you always know what your
            investment is producing.
          </p>
          <ul class="feature-list mt-m">
            <li><strong>Market &amp; competitor research</strong> — where the demand is and how you stack up.</li>
            <li><strong>Performance reporting</strong> — leads, calls, traffic, and pipeline in one monthly view.</li>
            <li><strong>Value reporting</strong> — a clear record of what was built and what it's worth.</li>
            <li><strong>Recommendations</strong> — the "so what" and "what's next," in language that's useful.</li>
          </ul>
          <div class="research-eg mt-m">
            <span class="label plain">Recent example</span>
            <p>A full market-research report for a prospective client weighing entry into a new service market — competitive landscape, demand signals, pricing, positioning, and a clear go / no-go recommendation.</p>
          </div>
        </div>
        <div class="mock reveal">
          <div class="mock-head"><span class="rdot done"></span> reporting · monthly growth report</div>
          <div class="mock-rows">
            <div class="mock-row"><span>Leads captured</span><b>148</b></div>
            <div class="mock-row"><span>Calls from Google</span><b>96</b></div>
            <div class="mock-row"><span>Est. pipeline value</span><b class="gold">$41,200</b></div>
            <div class="mock-row"><span>New 5-star reviews</span><b>27</b></div>
            <div class="mock-row"><span>Report status</span><b class="tag" style="font-family:var(--font-mono);font-size:.7rem;">delivered</b></div>
          </div>
        </div>
      </div>
    </section>

    <!-- 04 MARKETING -->
    <section class="ink section" id="marketing">
      <div class="container wide split lean">
        <div class="reveal">
          <div class="shot-frame">
            <Image src={aoWebsite} alt="Example client website built by Taylormade Brands" width={900} />
          </div>
        </div>
        <div>
          <p class="label">04 — Marketing, Brand &amp; Web</p>
          <h2>The front door to everything else.</h2>
          <p class="lead muted mt-s">
            Websites, branding, Google visibility, and lead systems still matter — they're how customers
            find and trust you. I build them to match the quality of the work behind them, and to feed the
            systems above.
          </p>
          <ul class="feature-list mt-m">
            <li><strong>Websites</strong> — fast, mobile-first sites built to turn visitors into leads.</li>
            <li><strong>Branding &amp; print</strong> — logos, brand kits, cards, signs, and customer touchpoints.</li>
            <li><strong>Google growth</strong> — Business Profile, reviews, local SEO, and Google Ads.</li>
            <li><strong>Lead systems</strong> — forms, QR codes, review generation, and follow-up.</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- WHO IT'S FOR -->
    <section class="paper-2 section">
      <div class="container wide">
        <div class="head center mx-auto">
          <p class="label center mx-auto">Where you fit</p>
          <h2>Different businesses start in different places.</h2>
        </div>
        <div class="grid-3">
          <div class="card num-card"><span class="index">01</span><h3>Getting established</h3><p class="muted">You need to look legitimate and get found fast — brand, website, and a Google foundation.</p></div>
          <div class="card num-card"><span class="index">02</span><h3>Ready for leads</h3><p class="muted">You have customers but your online presence and follow-up need to catch up and convert.</p></div>
          <div class="card num-card"><span class="index">03</span><h3>Ready to scale</h3><p class="muted">You need custom software, reporting, and a repeatable system — a real growth partner.</p></div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="ink section">
      <div class="container narrow">
        <div class="head">
          <p class="label">Common questions</p>
          <h2>What owners usually ask first.</h2>
        </div>
        <div class="faq">
          <details><summary>Do I have to buy everything at once?</summary><p>No. Most partnerships start with one high-leverage piece — often a website or a specific system — and grow from there as it proves out.</p></details>
          <details><summary>What kind of software do you actually build?</summary><p>Web apps that run in the browser and on phones — client portals, registration and booking systems, internal CRM and operations tools, dashboards, and reporting. All custom to the business.</p></details>
          <details><summary>Do you only work with local service businesses?</summary><p>That's where a lot of the work has been, but the approach fits any owner-led business — trades, teams and leagues, community organizations, and growing companies that have outgrown spreadsheets.</p></details>
          <details><summary>How is this different from a marketing agency?</summary><p>An agency sells you tasks. I work as a partner across software, strategy, research, and marketing — and everything is measured and reported, so you can see what it's producing.</p></details>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="ink-2 section">
      <div class="container narrow center">
        <p class="label center mx-auto">Start here</p>
        <h2 class="mt-s">Not sure where to start?</h2>
        <p class="lead muted mt-s mx-auto" style="max-width:56ch;">Take the growth assessment and I'll recommend the highest-leverage place to begin — and what to build after it.</p>
        <div class="btn-row mt-m" style="justify-content:center;">
          <a href="/growth-assessment.html" class="btn btn-primary">Take the assessment <span class="arrow">→</span></a>
          <a href="/contact.html" class="btn btn-ghost">Book a conversation</a>
        </div>
      </div>
    </section>
  </main>

  <style>
    .cap-index { align-self: stretch; }
    .cap-list { list-style: none; margin-top: 18px; display: grid; gap: 2px; }
    .cap-list li a { display: flex; align-items: center; gap: 14px; padding: 15px 0; border-bottom: 1px solid var(--line-d); font-family: var(--font-display); font-size: 1.15rem; color: var(--d-text); transition: color .2s var(--ease), gap .2s var(--ease); }
    .cap-list li:last-child a { border-bottom: 0; }
    .cap-list li a:hover { color: var(--gold); gap: 18px; }

    .mini-cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
    .mc-label { font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--d-faint); display: block; margin-bottom: 8px; }
    .mc-chip { display: block; background: var(--ink-3); border: 1px solid var(--line-d); border-radius: 8px; padding: 8px 10px; font-size: 0.74rem; color: var(--d-muted); margin-bottom: 8px; }
    .mc-chip.gold { border-color: var(--gold-deep); color: var(--gold-soft); }

    .roadmap-mock { display: grid; gap: 14px; }
    .rm-step { background: var(--ink-2); border: 1px solid var(--line-d); border-left: 2px solid var(--gold); border-radius: 12px; padding: 20px 22px; }
    .rm-step .index { text-transform: uppercase; letter-spacing: 0.12em; }
    .rm-step h4 { margin: 8px 0 6px; font-size: 1.15rem; }
    .rm-step p { font-size: 0.92rem; }

    .research-eg { border-left: 2px solid var(--gold); background: var(--paper-2); border-radius: 0 12px 12px 0; padding: 16px 20px; }
    .research-eg .label { margin-bottom: 8px; }
    .research-eg p { font-size: 0.98rem; color: var(--l-muted); }

    .shot-frame { border: 1px solid var(--line-d-2); border-radius: 16px; overflow: hidden; box-shadow: 0 40px 90px -55px #000; aspect-ratio: 4 / 3; }
    .shot-frame :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; }

    @media (max-width: 900px) {
      .split, .hero-split { grid-template-columns: 1fr; }
      .split.lean { grid-template-columns: 1fr; }
      .strat-visual { order: 2; }
      .grid-3 { grid-template-columns: 1fr; }
    }
  </style>
</Base>
