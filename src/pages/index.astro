---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import rhinoLogo from '../assets/clients/rhino-landworks.png';
import millersLogo from '../assets/clients/millers-backhoe.png';
import fordLogo from '../assets/clients/ford-paving.png';
import beehiveLogo from '../assets/clients/beehive-stars.png';

const clientLogos = [
  { src: rhinoLogo, name: 'Rhino Landworks' },
  { src: millersLogo, name: "Miller's Backhoe Service" },
  { src: fordLogo, name: 'Ford Paving & Sealing' },
  { src: beehiveLogo, name: 'Beehive Stars Baseball' },
];

const pillars = [
  {
    n: '01',
    title: 'Custom Software & Web Apps',
    body: 'Client portals, dashboards, registration systems, and internal tools built around how your business actually operates, not off-the-shelf software you have to bend around.',
    tags: ['Web apps', 'Portals', 'Dashboards', 'Automation'],
  },
  {
    n: '02',
    title: 'Growth Strategy',
    body: 'A clear plan for what to fix first and what to build next. I work as an ongoing partner in the business, not a vendor who disappears after launch.',
    tags: ['Roadmapping', 'Systems', 'Consulting'],
  },
  {
    n: '03',
    title: 'Research & Reporting',
    body: 'Market and competitor research, performance reporting, and plain-language recommendations so decisions are made on evidence instead of guesswork.',
    tags: ['Market research', 'Reporting', 'Analytics'],
  },
  {
    n: '04',
    title: 'Marketing, Brand & Web',
    body: 'Websites, branding, Google visibility, and lead systems: the front door to everything above, built to match the quality of the work behind it.',
    tags: ['Websites', 'Branding', 'Google', 'Ads'],
  },
];
---

<Base
  title="Taylormade Brands | Your Partner in Business Growth"
  description="Taylormade Brands is a growth partner for owner-led businesses. Custom software, growth strategy, research, and reporting that make good businesses run and grow better."
>
  <main>
    <!-- HERO + SCROLL STORY (one pinned scene on desktop; stacked with a sticky window on mobile) -->
    <section class="scene" id="scene">
      <div class="scene-pin ink grid-bg">
        <div class="scene-glow" aria-hidden="true" style="--gx:78%;--gy:8%"></div>
        <div class="container wide scene-grid">
          <div class="scene-copy">
            <!-- Frame 0: hero copy -->
            <div class="frame hero-copy" data-frame="0">
              <p class="label">Your partner in business growth</p>
              <h1 class="display">
                I build the <span class="gold serif-em">systems</span> good businesses grow on.
              </h1>
              <p class="lead muted">
                Taylormade Brands is a growth partner for owner-led companies. Custom software,
                strategy, research, and reporting. Not one-off marketing tasks. The tools and systems
                your business actually runs on.
              </p>
              <div class="btn-row mt-m">
                <a href="/growth-assessment.html" class="btn btn-primary">Start with an assessment <span class="arrow">→</span></a>
                <a href="/work.html" class="btn btn-ghost">See the work</a>
              </div>

              <div class="hero-meta">
                <div><span class="stat-num">New business</span><p class="stat-label">generated for local clients, and growing</p></div>
                <div class="hero-meta-rule"></div>
                <div><span class="stat-num">4</span><p class="stat-label">custom platforms &amp; apps in production</p></div>
              </div>
            </div>

            <!-- Frame 1: custom software -->
            <div class="frame chapter" data-frame="1">
              <p class="label">01 · Custom software</p>
              <h2>Software built around how your crews actually work.</h2>
              <p class="lead muted">
                The A&amp;O Tree Service app runs estimating, crew scheduling, routes, payments, and
                reporting in one tool. Built for the field, not the boardroom.
              </p>
              <a href="/work.html" class="text-link mt-m">See the platforms <span class="arrow">→</span></a>
            </div>

            <!-- Frame 2: growth strategy -->
            <div class="frame chapter" data-frame="2">
              <p class="label">02 · Growth strategy</p>
              <h2>A clear plan for what to fix first and what to build next.</h2>
              <p class="lead muted">
                I sit on your side of the table as an ongoing partner. We map the business, pick the
                highest-leverage moves, and build them in order.
              </p>
              <a href="/services.html" class="text-link mt-m">How we work <span class="arrow">→</span></a>
            </div>
          </div>

          <div class="scene-visual">
            <!-- The window: one shell, four faces -->
            <div class="window-wrap" aria-hidden="true">
              <div class="window-float">
                <div class="app-window">
                  <div class="faces">

                    <!-- Face 0: client dashboard -->
                    <div class="face face-dash is-active" data-face="0">
                      <div class="app-bar">
                        <span class="dot"></span><span class="dot"></span><span class="dot"></span>
                        <span class="app-title">growth&nbsp;·&nbsp;client dashboard</span>
                      </div>
                      <div class="face-body">
                        <div class="app-kpis">
                          <div class="kpi"><span class="kpi-label">Leads / mo</span><span class="kpi-val">148</span><span class="kpi-up">▲ 32%</span></div>
                          <div class="kpi"><span class="kpi-label">Booked</span><span class="kpi-val">$41k</span><span class="kpi-up">▲ 18%</span></div>
                          <div class="kpi"><span class="kpi-label">Reviews</span><span class="kpi-val">4.9★</span><span class="kpi-up">▲ 27</span></div>
                        </div>
                        <div class="app-chart">
                          <div class="chart-head"><span>Pipeline value</span><span class="chart-tag">last 6 mo</span></div>
                          <svg viewBox="0 0 320 120" preserveAspectRatio="none" class="spark">
                            <defs>
                              <linearGradient id="fill" x1="0" y1="0" x2="0" y2="1">
                                <stop offset="0%" stop-color="var(--growth)" stop-opacity="0.35" />
                                <stop offset="100%" stop-color="var(--growth)" stop-opacity="0" />
                              </linearGradient>
                            </defs>
                            <path d="M0,96 L53,84 L106,88 L160,58 L213,44 L266,26 L320,14 L320,120 L0,120 Z" fill="url(#fill)" />
                            <path d="M0,96 L53,84 L106,88 L160,58 L213,44 L266,26 L320,14" fill="none" stroke="var(--growth)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                          </svg>
                        </div>
                        <div class="app-rows">
                          <div class="app-row"><span class="rdot done"></span>Website + lead form live<span class="rmeta">done</span></div>
                          <div class="app-row"><span class="rdot done"></span>Google profile optimized<span class="rmeta">done</span></div>
                          <div class="app-row"><span class="rdot active"></span>Client portal build<span class="rmeta">in&nbsp;progress</span></div>
                          <div class="app-row"><span class="rdot"></span>Monthly growth report<span class="rmeta">scheduled</span></div>
                        </div>
                      </div>
                    </div>

                    <!-- Face 1: field operations app -->
                    <div class="face face-app" data-face="1">
                      <div class="app-bar">
                        <span class="dot"></span><span class="dot"></span><span class="dot"></span>
                        <span class="app-title">a&amp;o tree service&nbsp;·&nbsp;field app</span>
                        <span class="app-pill">live</span>
                      </div>
                      <div class="face-body app-layout">
                        <div class="app-side">
                          <span class="face-label">Today · 3 crews</span>
                          <div class="job"><span class="job-time">7:30</span><div class="job-text"><b>Oak removal</b><small>Auburn · Crew A</small></div><span class="rdot done"></span></div>
                          <div class="job"><span class="job-time">9:15</span><div class="job-text"><b>Storm cleanup</b><small>Opelika · Crew B</small></div><span class="rdot active"></span></div>
                          <div class="job"><span class="job-time">1:00</span><div class="job-text"><b>Stump grinding</b><small>Lake Martin · Crew A</small></div><span class="rdot"></span></div>
                          <div class="job"><span class="job-time">3:30</span><div class="job-text"><b>Lot clearing</b><small>Dadeville · Crew C</small></div><span class="rdot"></span></div>
                        </div>
                        <div class="app-main">
                          <div class="map">
                            <svg viewBox="0 0 220 150" preserveAspectRatio="none" class="map-svg">
                              <path d="M18,118 C50,96 62,60 98,58 S150,86 196,30" fill="none" stroke="var(--gold)" stroke-width="2" stroke-dasharray="4 5" stroke-linecap="round" />
                              <circle cx="18" cy="118" r="6" fill="var(--growth)" />
                              <circle cx="98" cy="58" r="6" fill="var(--gold)" />
                              <circle cx="98" cy="58" r="12" fill="none" stroke="var(--gold)" stroke-opacity=".35" />
                              <circle cx="196" cy="30" r="6" fill="var(--ink)" stroke="var(--d-faint)" stroke-width="2" />
                            </svg>
                            <span class="map-tag">Route · 42 mi · 3 stops</span>
                          </div>
                          <div class="estimate">
                            <span class="face-label">Estimate #2381</span>
                            <b class="est-val">$4,850</b>
                            <span class="kpi-up">approved · paid online</span>
                          </div>
                        </div>
                      </div>
                    </div>

                    <!-- Face 2: growth plan -->
                    <div class="face face-plan" data-face="2">
                      <div class="app-bar">
                        <span class="dot"></span><span class="dot"></span><span class="dot"></span>
                        <span class="app-title">growth plan&nbsp;·&nbsp;next 90 days</span>
                      </div>
                      <div class="face-body plan-layout">
                        <div class="plan-progress">
                          <div class="chart-head"><span>Plan progress</span><span class="plan-pct">62%</span></div>
                          <div class="bar"><i style="width:62%"></i></div>
                        </div>
                        <div class="stack-cols plan-cols">
                          <div class="stack-col">
                            <span class="col-label">Now</span>
                            <div class="chip chip-done">Google profile cleanup</div>
                            <div class="chip chip-done">Lead form + call tracking</div>
                            <div class="chip gold-chip">Review generation</div>
                          </div>
                          <div class="stack-col">
                            <span class="col-label">Next</span>
                            <div class="chip">Client portal</div>
                            <div class="chip">Monthly value report</div>
                            <div class="chip">Hiring page</div>
                          </div>
                          <div class="stack-col">
                            <span class="col-label">Later</span>
                            <div class="chip">Field app v2</div>
                            <div class="chip">Second service area</div>
                          </div>
                        </div>
                      </div>
                    </div>

                    <!-- Face 3: monthly report -->
                    <div class="face face-report" data-face="3">
                      <div class="app-bar">
                        <span class="dot"></span><span class="dot"></span><span class="dot"></span>
                        <span class="app-title">monthly value report&nbsp;·&nbsp;october</span>
                      </div>
                      <div class="face-body report-layout">
                        <div class="app-chart report-chart">
                          <div class="chart-head"><span>Calls from Google</span><span class="chart-tag">6 months</span></div>
                          <svg viewBox="0 0 320 110" preserveAspectRatio="none" class="bars">
                            <rect x="10"  y="70" width="34" height="40" rx="4" fill="var(--ink-3)" />
                            <rect x="64"  y="58" width="34" height="52" rx="4" fill="var(--ink-3)" />
                            <rect x="118" y="62" width="34" height="48" rx="4" fill="var(--ink-3)" />
                            <rect x="172" y="40" width="34" height="70" rx="4" fill="var(--ink-3)" />
                            <rect x="226" y="26" width="34" height="84" rx="4" fill="var(--ink-3)" />
                            <rect x="280" y="6"  width="34" height="104" rx="4" fill="var(--gold)" />
                          </svg>
                        </div>
                        <div class="report-rows">
                          <div class="report-row"><span>Calls from Google</span><b>212 <small class="kpi-up">▲ 41%</small></b></div>
                          <div class="report-row"><span>Form leads</span><b>64 <small class="kpi-up">▲ 22%</small></b></div>
                          <div class="report-row"><span>Cost per lead</span><b>$18 <small class="kpi-up">▼ 31%</small></b></div>
                          <div class="report-row"><span>New five-star reviews</span><b class="gold">31</b></div>
                        </div>
                      </div>
                    </div>

                  </div>
                </div>
              </div>
            </div>

            <!-- Frame 3: research and reporting (sits where the window started, after it crosses the page) -->
            <div class="frame chapter chapter-right" data-frame="3">
              <p class="label">03 · Research &amp; reporting</p>
              <h2>Decisions made on evidence, not guesswork.</h2>
              <p class="lead muted">
                Market research, competitor analysis, and a monthly report in plain language that shows
                what worked, what did not, and what comes next.
              </p>
              <a href="/free-audit.html" class="text-link mt-m">Start with a free audit <span class="arrow">→</span></a>
            </div>
          </div>
        </div>

        <!-- Desktop only: progress dots and scroll hint -->
        <div class="scene-steps" aria-hidden="true">
          <span class="step is-on" data-step="0"></span>
          <span class="step" data-step="1"></span>
          <span class="step" data-step="2"></span>
          <span class="step" data-step="3"></span>
          <span class="step-label">Start</span>
        </div>
        <div class="scroll-hint" aria-hidden="true"><span>Scroll</span><i></i></div>
      </div>
    </section>

    <!-- TRUST STRIP -->
    <section class="ink-2 trust">
      <div class="container wide">
        <p class="label plain center trust-title">Trusted by owner-led businesses across Alabama</p>
        <div class="marquee mt-m">
          <div class="marquee-track">
            {[...clientLogos, ...clientLogos].map((c) => (
              <span class="trust-plate"><Image src={c.src} alt={`${c.name} logo`} width={220} class="trust-logo" loading="lazy" /></span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- POSITIONING -->
    <section class="paper section">
      <div class="container narrow center">
        <p class="label center mx-auto">The shift</p>
        <h2 class="mt-s reposition">
          Most agencies sell you tasks.<br />
          I build what the business <span class="gold serif-em">runs on.</span>
        </h2>
        <p class="lead muted mt-m mx-auto" style="max-width: 62ch;">
          A website or a logo is one piece. Real growth comes from the systems underneath:
          the software that runs operations, the research that guides decisions, and the reporting
          that shows what's working. That's the work I've grown into, and it's what a true partner
          should bring to the table.
        </p>
      </div>
    </section>

    <!-- RANGE: SMALL TO COMPLEX -->
    <section class="ink section">
      <div class="container wide">
        <div class="head">
          <p class="label">What can Taylormade do for you?</p>
          <h2>From a single fix to a full system.</h2>
          <p>No job is too small and none is too complex. Wherever your business is right now, there is a simple place to start.</p>
        </div>
        <div class="grid-3">
          <article class="card range-card reveal">
            <span class="range-badge">Start small</span>
            <h3>One thing, done right</h3>
            <p class="muted">Need a single piece handled? A sharper logo, a faster website, a cleaned-up Google profile, or more reviews coming in.</p>
            <ul class="feature-list mt-m">
              <li>Logo or brand refresh</li>
              <li>A new or updated website</li>
              <li>Google Business Profile cleanup</li>
              <li>Review generation</li>
            </ul>
          </article>
          <article class="card range-card reveal">
            <span class="range-badge">Build momentum</span>
            <h3>The full local presence</h3>
            <p class="muted">Ready for the pieces to work together? Brand, website, Google, ads, and follow-up built as one growth system.</p>
            <ul class="feature-list mt-m">
              <li>Brand and lead-generating website</li>
              <li>Google Ads and local SEO</li>
              <li>Reviews and follow-up systems</li>
              <li>Monthly growth management</li>
            </ul>
          </article>
          <article class="card range-card reveal">
            <span class="range-badge">Go custom</span>
            <h3>Software and partnership</h3>
            <p class="muted">Outgrown the basics? Custom web apps, dashboards, research, and reporting, with one partner across the whole business.</p>
            <ul class="feature-list mt-m">
              <li>Custom apps, portals, and booking</li>
              <li>Dashboards and automation</li>
              <li>Research and monthly reporting</li>
              <li>Ongoing growth partnership</li>
            </ul>
          </article>
        </div>
        <p class="range-foot center mx-auto">Not sure which fits? <a href="/free-audit.html" class="text-link">Start with a free visibility audit <span class="arrow">→</span></a></p>
      </div>
    </section>

    <!-- CAPABILITY PILLARS -->
    <section class="ink-2 section">
      <div class="container wide">
        <div class="head">
          <p class="label">What I do</p>
          <h2>Four capabilities, working as one system.</h2>
          <p>Each piece supports the next. Software captures and organizes the work, research points to
            the right moves, reporting proves it out, and marketing brings the demand in.</p>
        </div>

        <div class="pillar-grid">
          {pillars.map((p) => (
            <article class="card pillar reveal">
              <span class="index">{p.n}</span>
              <h3>{p.title}</h3>
              <p class="muted">{p.body}</p>
              <div class="tags mt-m">{p.tags.map((t) => <span class="tag">{t}</span>)}</div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- SOFTWARE SPOTLIGHT -->
    <section class="ink section">
      <div class="container wide software-grid">
        <div class="software-copy">
          <p class="label">The differentiator</p>
          <h2>I don't just market your business.<br />I build the tools it runs on.</h2>
          <p class="lead muted mt-s">
            Custom web apps and platforms: a CRM and operations system, client portals, a team
            registration platform, monthly reporting, built on a modern stack and tailored to each
            business. This is what moves a relationship from "marketing help" to "growth partner."
          </p>
          <ul class="feature-list mt-m">
            <li><strong>Field operations apps</strong>, like the A&amp;O Tree Service app: estimating, crew scheduling, route optimization, payments, and reporting in one tool.</li>
            <li><strong>Club &amp; member platforms</strong>, like the Beehive Stars platform: registration, team pages, tryout scoring, and digital waivers.</li>
            <li><strong>Operations &amp; reporting</strong>: pipeline, invoicing, and automated monthly client reports behind every partnership.</li>
          </ul>
          <a href="/work.html" class="text-link mt-m">Explore the platforms <span class="arrow">→</span></a>
        </div>

        <div class="software-visual reveal">
          <div class="stack-card">
            <div class="stack-head"><span class="rdot active"></span> operations · pipeline</div>
            <div class="stack-cols">
              <div class="stack-col">
                <span class="col-label">New</span>
                <div class="chip">Rhino Landworks</div>
                <div class="chip">Estimate req.</div>
              </div>
              <div class="stack-col">
                <span class="col-label">Building</span>
                <div class="chip gold-chip">A&amp;O portal</div>
                <div class="chip">Ford Paving</div>
              </div>
              <div class="stack-col">
                <span class="col-label">Live</span>
                <div class="chip">Beehive app</div>
                <div class="chip">Miller's site</div>
              </div>
            </div>
          </div>
          <div class="stack-card offset">
            <div class="stack-head"><span class="rdot done"></span> reporting · monthly value report</div>
            <div class="report-rows">
              <div class="report-row"><span>Leads captured</span><b>148</b></div>
              <div class="report-row"><span>Est. pipeline value</span><b class="gold">$41,200</b></div>
              <div class="report-row"><span>New reviews</span><b>27</b></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- PROCESS -->
    <section class="paper section">
      <div class="container wide">
        <div class="head center mx-auto">
          <p class="label center mx-auto">How we work together</p>
          <h2>A partnership, not a project.</h2>
          <p class="mx-auto">Most engagements follow the same rhythm: understand, build, measure, repeat.</p>
        </div>
        <div class="process-grid">
          <div class="process-step reveal"><span class="index">01</span><h3>Assess</h3><p class="muted">A full look at the business: operations, online presence, and where growth is leaking. You get a clear read on what to fix first.</p></div>
          <div class="process-step reveal"><span class="index">02</span><h3>Build</h3><p class="muted">Websites, brand, and the custom software and systems that make the business run better and capture more of its demand.</p></div>
          <div class="process-step reveal"><span class="index">03</span><h3>Report</h3><p class="muted">Research and monthly reporting turn activity into evidence: what worked, what didn't, and what's next.</p></div>
          <div class="process-step reveal"><span class="index">04</span><h3>Grow</h3><p class="muted">We iterate as a partnership. The system compounds, and the business keeps pulling ahead of its market.</p></div>
        </div>
      </div>
    </section>

    <!-- RESULTS -->
    <section class="ink section">
      <div class="container wide">
        <div class="results-grid">
          <div class="results-lead">
            <p class="label">The impact</p>
            <h2>Built to bring in real business.</h2>
            <p class="muted mt-s">I don't build things that only look good. I build them to generate leads,
              organize the work, and grow revenue, and for the businesses I partner with, that has meant
              real, sustained new business.</p>
            <p class="results-quote">“One client called just to say thank you. Another said their office is
              tired of answering the phone.” <span class="muted">That is the kind of problem worth creating.</span></p>
          </div>
          <div class="results-stats">
            <div class="rstat reveal"><span class="stat-num">New revenue</span><p class="stat-label">landed by local clients after launching their growth systems</p></div>
            <div class="rstat reveal"><span class="stat-num">Booked out</span><p class="stat-label">demand so strong clients have hired new employees to keep up</p></div>
            <div class="rstat reveal"><span class="stat-num">Search-led</span><p class="stat-label">for some clients, almost every new customer now comes from their website and Google</p></div>
          </div>
        </div>
        <p class="disclaimer">Results reflect outcomes reported by clients and vary by business. Individual results are not guaranteed.</p>
      </div>
    </section>

    <!-- CTA -->
    <section class="ink-2 section cta">
      <div class="container narrow center">
        <p class="label center mx-auto">Start here</p>
        <h2 class="mt-s">Let's find what your business needs first.</h2>
        <p class="lead muted mt-s mx-auto" style="max-width: 56ch;">
          The growth assessment is the front door. I'll review where you are, what's missing,
          and the highest-leverage place to start: software, strategy, research, or all of it.
        </p>
        <div class="btn-row mt-m" style="justify-content:center;">
          <a href="/growth-assessment.html" class="btn btn-primary">Take the assessment <span class="arrow">→</span></a>
          <a href="/contact.html" class="btn btn-ghost">Book a conversation</a>
        </div>
      </div>
    </section>
  </main>

  <script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    import { initSmooth } from '../scripts/smooth';

    gsap.registerPlugin(ScrollTrigger);

    const scene = document.getElementById('scene');
    if (scene) {
      const q = (sel: string) => scene.querySelector<HTMLElement>(sel)!;
      const qa = (sel: string) => Array.from(scene.querySelectorAll<HTMLElement>(sel));
      const pin = q('.scene-pin');
      const copy = q('.scene-copy');
      const visual = q('.scene-visual');
      const wrap = q('.window-wrap');
      const glow = q('.scene-glow');
      const hint = q('.scroll-hint');
      const stepLabel = q('.step-label');
      const faces = qa('.face');
      const frames = qa('.frame');
      const steps = qa('.step');
      const STEP_NAMES = ['Start', 'Software', 'Strategy', 'Reporting'];

      const lenis = initSmooth();
      if (lenis) lenis.on('scroll', ScrollTrigger.update);

      const setStep = (i: number) => {
        steps.forEach((s, k) => s.classList.toggle('is-on', k === i));
        stepLabel.textContent = STEP_NAMES[i];
      };
      const setFace = (i: number) => faces.forEach((f, k) => f.classList.toggle('is-active', k === i));

      const mm = gsap.matchMedia();

      // Desktop: pin the scene and scrub one timeline. The window tilts, flips
      // through its four faces, and finally crosses to the left column.
      mm.add('(min-width: 981px) and (prefers-reduced-motion: no-preference)', () => {
        const headerH = () =>
          parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-h')) || 112;
        // Distance from the visual column's center to the copy column's center.
        const crossX = () => {
          const c = copy.getBoundingClientRect();
          const v = visual.getBoundingClientRect();
          return c.left + c.width / 2 - (v.left + v.width / 2);
        };

        gsap.set(frames.slice(1), { autoAlpha: 0 });
        gsap.set(faces, { autoAlpha: 0, transformPerspective: 1200 });
        gsap.set(faces[0], { autoAlpha: 1 });
        gsap.set(wrap, { rotationY: -12, rotationX: 7, transformPerspective: 1500, transformOrigin: '50% 50%' });

        const tl = gsap.timeline({
          defaults: { ease: 'none' },
          scrollTrigger: {
            trigger: scene,
            pin,
            start: () => 'top ' + headerH(),
            end: '+=340%',
            scrub: 0.6,
            anticipatePin: 1,
            invalidateOnRefresh: true,
            onUpdate: (self) => {
              const p = self.progress;
              setStep(p < 0.12 ? 0 : p < 0.43 ? 1 : p < 0.76 ? 2 : 3);
            },
          },
        });

        const swapFace = (from: number, to: number, at: number) => {
          tl.to(faces[from], { autoAlpha: 0, rotationY: -40, x: -60, duration: 0.4 }, at)
            .fromTo(faces[to], { autoAlpha: 0, rotationY: 40, x: 60 }, { autoAlpha: 1, rotationY: 0, x: 0, duration: 0.5 }, at + 0.42);
        };
        const swapFrame = (from: number, to: number, at: number) => {
          tl.to(frames[from], { autoAlpha: 0, y: -50, duration: 0.4 }, at)
            .fromTo(frames[to], { autoAlpha: 0, y: 50 }, { autoAlpha: 1, y: 0, duration: 0.5 }, at + 0.45);
        };

        // 1. Hero to software
        tl.to(hint, { autoAlpha: 0, duration: 0.2 }, 0);
        swapFrame(0, 1, 0);
        tl.to(wrap, { rotationY: 14, rotationX: -5, scale: 1.05, y: -24, x: -30, duration: 1 }, 0);
        swapFace(0, 1, 0.25);
        tl.to(glow, { '--gx': '30%', '--gy': '60%', duration: 1 }, 0);

        // 2. Software to strategy
        swapFrame(1, 2, 1.6);
        tl.to(wrap, { rotationY: -10, rotationX: 6, scale: 1.08, y: 10, x: 20, duration: 1 }, 1.6);
        swapFace(1, 2, 1.85);
        tl.to(glow, { '--gx': '80%', '--gy': '70%', duration: 1 }, 1.6);

        // 3. Strategy to reporting: the window crosses the page, then the copy lands behind it
        tl.to(frames[2], { autoAlpha: 0, y: -50, duration: 0.4 }, 3.2);
        tl.to(wrap, { x: crossX, y: 0, rotationY: 0, rotationX: 0, scale: 1, duration: 1.1, ease: 'power1.inOut' }, 3.2);
        swapFace(2, 3, 3.5);
        tl.to(glow, { '--gx': '20%', '--gy': '20%', duration: 1 }, 3.2);
        tl.fromTo(frames[3], { autoAlpha: 0, y: 50 }, { autoAlpha: 1, y: 0, duration: 0.5 }, 4.1);

        // Hold on the final frame before the page releases
        tl.to({}, { duration: 0.7 }, 4.6);
      });

      // Stacked (mobile, reduced motion): the window is sticky; chapters set the face.
      mm.add('(max-width: 980px), (prefers-reduced-motion: reduce)', () => {
        const chapters = frames.filter((f) => f.dataset.frame !== '0');
        const triggers = chapters.map((ch) => {
          const i = Number(ch.dataset.frame);
          return ScrollTrigger.create({
            trigger: ch,
            start: 'top 72%',
            end: 'bottom 40%',
            onEnter: () => setFace(i),
            onEnterBack: () => setFace(i),
            onLeaveBack: () => { if (i === 1) setFace(0); },
          });
        });
        return () => triggers.forEach((t) => t.kill());
      });
    }
  </script>

  <style>
    /* =====================================================================
       SCENE: hero + scroll story
       Default layout is stacked (mobile, reduced motion, no JS): the window
       sticks under the header while the chapters scroll past it.
       Desktop with JS pins the whole scene and GSAP drives the window.
       ===================================================================== */
    .scene { background: var(--ink); position: relative; }
    .scene-pin { position: relative; padding: clamp(56px, 8vw, 88px) 0 clamp(40px, 6vw, 64px); }
    .scene-glow {
      position: absolute; inset: 0; pointer-events: none;
      background: radial-gradient(60% 60% at var(--gx, 78%) var(--gy, 8%), rgba(201,162,74,.18), transparent 60%);
    }
    .scene-grid { position: relative; z-index: 1; display: flex; flex-direction: column; width: 100%; }
    .scene-copy, .scene-visual { display: contents; }
    .frame { max-width: 620px; }
    .frame[data-frame="0"] { order: 0; }
    .window-wrap { order: 1; }
    .frame[data-frame="1"] { order: 2; }
    .frame[data-frame="2"] { order: 3; }
    .frame[data-frame="3"] { order: 4; }

    .hero-copy h1 { margin: 22px 0 24px; }
    .frame .lead { max-width: 56ch; }
    .hero-meta { display: flex; align-items: center; gap: 32px; margin-top: 48px; }
    .hero-meta-rule { width: 1px; height: 54px; background: var(--line-d); }
    .chapter { position: relative; z-index: 1; padding-top: clamp(64px, 14vh, 120px); min-height: 56vh; }
    .chapter h2 { margin: 18px 0 18px; font-size: clamp(1.8rem, 3.3vw, 2.9rem); }
    .chapter .lead { font-size: clamp(1.02rem, 1.3vw, 1.2rem); }

    /* Sticky window (stacked mode) */
    .window-wrap {
      position: sticky;
      top: calc(var(--header-h) + 14px);
      z-index: 2;
      width: min(100%, 380px);
      margin: 44px auto 0;
    }
    .window-wrap::before {
      content: "";
      position: absolute;
      inset: -14% -10% -18% -10%;
      background:
        radial-gradient(52% 48% at 58% 28%, rgba(255,255,255,.10), transparent 70%),
        radial-gradient(46% 46% at 84% 82%, rgba(201,162,74,.24), transparent 70%);
      filter: blur(14px);
      z-index: 0;
      pointer-events: none;
    }
    .app-window {
      position: relative;
      z-index: 1;
      background: linear-gradient(180deg, #262425 0%, #141313 100%);
      border: 1px solid rgba(255,255,255,.16);
      border-radius: 18px;
      box-shadow:
        0 34px 80px -28px rgba(0,0,0,.9),
        0 0 0 1px rgba(201,162,74,.10),
        inset 0 1px 0 rgba(255,255,255,.08);
      overflow: hidden;
    }
    .faces { position: relative; aspect-ratio: 1.15 / 1; container-type: inline-size; }
    .face {
      position: absolute; inset: 0;
      display: flex; flex-direction: column;
      opacity: 0; visibility: hidden;
      transition: opacity .55s var(--ease), visibility .55s;
      font-size: clamp(0.8rem, 2.9cqi, 1rem); /* internal type scales with the window */
    }
    .face.is-active { opacity: 1; visibility: visible; }
    .face-body { flex: 1; min-height: 0; padding: 1.1em; display: flex; flex-direction: column; gap: 0.9em; }

    /* Window chrome */
    .app-bar { display: flex; align-items: center; gap: 7px; padding: 0.8em 1em; border-bottom: 1px solid var(--line-d); }
    .app-bar .dot { width: 0.6em; height: 0.6em; border-radius: 50%; background: var(--line-d-2); }
    .app-title { font-family: var(--font-mono); font-size: 0.72em; color: var(--d-faint); margin-left: 0.6em; letter-spacing: 0.04em; white-space: nowrap; }
    .app-pill { margin-left: auto; font-family: var(--font-mono); font-size: 0.6em; letter-spacing: 0.1em; text-transform: uppercase; color: var(--growth); border: 1px solid rgba(87,192,138,.4); border-radius: 999px; padding: 0.25em 0.7em; }
    .face-label, .kpi-label, .col-label { font-family: var(--font-mono); font-size: 0.64em; letter-spacing: 0.08em; text-transform: uppercase; color: var(--d-faint); }

    /* Face 0: dashboard */
    .app-kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.7em; }
    .kpi { background: var(--ink); border: 1px solid var(--line-d); border-radius: 0.75em; padding: 0.8em; display: flex; flex-direction: column; gap: 0.25em; min-width: 0; }
    .kpi-val { font-family: var(--font-display); font-size: 1.5em; color: var(--d-text); line-height: 1; }
    .kpi-up { font-family: var(--font-mono); font-size: 0.66em; color: var(--growth); }
    .app-chart { flex: 1; min-height: 0; display: flex; flex-direction: column; background: var(--ink); border: 1px solid var(--line-d); border-radius: 0.75em; padding: 0.8em 0.8em 0.4em; }
    .chart-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5em; }
    .chart-head span { font-family: var(--font-mono); font-size: 0.68em; color: var(--d-muted); letter-spacing: 0.04em; }
    .chart-tag { color: var(--d-faint) !important; }
    .spark, .bars { flex: 1; width: 100%; min-height: 2.4em; height: auto; display: block; }
    .app-rows { display: grid; gap: 0; }
    .app-row { display: flex; align-items: center; gap: 0.6em; font-size: 0.82em; color: var(--d-muted); padding: 0.5em 0.25em; border-bottom: 1px solid var(--line-d); }
    .app-row:last-child { border-bottom: 0; }
    .rmeta { margin-left: auto; font-family: var(--font-mono); font-size: 0.64em; color: var(--d-faint); letter-spacing: 0.04em; }
    .rdot { width: 0.56em; height: 0.56em; border-radius: 50%; border: 1.5px solid var(--line-d-2); flex: none; }
    .rdot.done { background: var(--growth); border-color: var(--growth); }
    .rdot.active { background: var(--gold); border-color: var(--gold); box-shadow: 0 0 0 0.25em rgba(201,162,74,.18); }

    /* Face 1: field app */
    .app-layout { flex-direction: row; }
    .app-side { flex: 0 0 47%; display: flex; flex-direction: column; gap: 0.5em; min-width: 0; }
    .job { display: flex; align-items: center; gap: 0.6em; background: var(--ink); border: 1px solid var(--line-d); border-radius: 0.7em; padding: 0.55em 0.65em; min-width: 0; }
    .job-time { font-family: var(--font-mono); font-size: 0.64em; color: var(--gold); flex: none; }
    .job-text { min-width: 0; }
    .job-text b { display: block; font-size: 0.8em; font-weight: 600; color: var(--d-text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .job-text small { display: block; font-size: 0.64em; color: var(--d-faint); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .job .rdot { margin-left: auto; }
    .app-main { flex: 1; display: flex; flex-direction: column; gap: 0.7em; min-width: 0; }
    .map {
      flex: 1; min-height: 0; position: relative; overflow: hidden;
      background: var(--ink); border: 1px solid var(--line-d); border-radius: 0.75em;
      background-image: linear-gradient(var(--line-d) 1px, transparent 1px), linear-gradient(90deg, var(--line-d) 1px, transparent 1px);
      background-size: 1.6em 1.6em;
    }
    .map-svg { position: absolute; inset: 0; width: 100%; height: 100%; }
    .map-tag { position: absolute; left: 0.6em; bottom: 0.6em; font-family: var(--font-mono); font-size: 0.6em; color: var(--d-muted); background: rgba(12,11,11,.75); border: 1px solid var(--line-d); padding: 0.3em 0.6em; border-radius: 0.4em; }
    .estimate { background: var(--ink); border: 1px solid var(--gold-deep); border-radius: 0.75em; padding: 0.75em 0.9em; display: flex; flex-direction: column; gap: 0.25em; }
    .est-val { font-family: var(--font-display); font-size: 1.55em; color: var(--gold); line-height: 1; }

    /* Face 2: growth plan */
    .plan-progress { background: var(--ink); border: 1px solid var(--line-d); border-radius: 0.75em; padding: 0.8em; }
    .plan-pct { color: var(--gold) !important; }
    .bar { height: 0.4em; background: var(--ink-3); border-radius: 999px; overflow: hidden; margin-top: 0.5em; }
    .bar i { display: block; height: 100%; background: linear-gradient(90deg, var(--gold-deep), var(--gold-soft)); border-radius: 999px; }
    .plan-cols { flex: 1; align-content: start; }
    .face .chip { font-size: 0.78em; padding: 0.55em 0.7em; margin-bottom: 0.5em; border-radius: 0.5em; }
    .chip-done::before { content: "✓ "; color: var(--growth); }
    @container (max-width: 430px) {
      .plan-cols { grid-template-columns: 1fr 1fr; }
      .plan-cols .stack-col:nth-child(3) { display: none; }
    }

    /* Face 3: report */
    .report-chart { flex: 1; min-height: 7em; }
    .face .report-row { padding: 0.6em 0; font-size: 0.9em; }
    .face .report-row b { font-size: 1.15em; }
    .face .report-row b small { font-family: var(--font-mono); font-size: 0.6em; margin-left: 0.3em; font-weight: 400; }

    /* Desktop-only helpers hidden by default */
    .scene-steps, .scroll-hint { display: none; }

    /* ---------- Desktop with JS: pinned 3D scene ---------- */
    @media (min-width: 981px) and (prefers-reduced-motion: no-preference) {
      :global(.js) .scene-pin {
        min-height: calc(100vh - var(--header-h));
        display: flex; align-items: center;
        padding: clamp(20px, 3vh, 48px) 0 clamp(44px, 6vh, 64px);
        overflow: hidden;
      }
      /* The hero frame has to fit inside one pinned viewport, so it scales with height too */
      :global(.js) .hero-copy h1 { font-size: clamp(2.4rem, min(6.2vw, 7.4vh), 5rem); margin: 16px 0 18px; }
      :global(.js) .hero-copy .lead { font-size: clamp(1.02rem, 1.3vw, 1.2rem); max-width: 52ch; }
      :global(.js) .hero-meta { margin-top: clamp(20px, 3.6vh, 40px); }
      :global(.js) .hero-meta .stat-num { font-size: clamp(1.6rem, 3vh + 0.4rem, 2.5rem); }
      :global(.js) .hero-meta .stat-label { font-size: 0.9rem; margin-top: 6px; }
      :global(.js) .hero-meta-rule { height: 44px; }
      :global(.js) .scene-grid { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: clamp(32px, 5vw, 72px); align-items: center; }
      :global(.js) .scene-copy { display: grid; align-items: center; }
      :global(.js) .scene-copy .frame { grid-area: 1 / 1; }
      :global(.js) .scene-visual { display: grid; align-items: center; justify-items: center; }
      :global(.js) .scene-visual > * { grid-area: 1 / 1; }
      :global(.js) .frame { order: 0; }
      :global(.js) .chapter { padding-top: 0; min-height: 0; }
      :global(.js) .chapter-right { max-width: 540px; justify-self: start; }
      /* Hidden until GSAP shows them, so nothing stacks before the script runs */
      :global(.js) .frame[data-frame="1"],
      :global(.js) .frame[data-frame="2"],
      :global(.js) .frame[data-frame="3"] { opacity: 0; visibility: hidden; }
      :global(.js) .window-wrap {
        position: relative; top: auto; margin: 0;
        width: min(100%, calc((100vh - var(--header-h) - 150px) * 1.15), 580px);
        will-change: transform;
      }
      :global(.js) .window-float { animation: float 7s ease-in-out infinite; }
      :global(.js) .face { transition: none; }

      :global(.js) .scene-steps {
        display: flex; flex-direction: column; align-items: center; gap: 12px;
        position: absolute; right: clamp(16px, 2.5vw, 36px); top: 50%; transform: translateY(-50%); z-index: 3;
      }
      .step { width: 6px; height: 6px; border-radius: 50%; background: var(--line-d-2); transition: background .3s var(--ease), transform .3s var(--ease); }
      .step.is-on { background: var(--gold); transform: scale(1.6); }
      .step-label { writing-mode: vertical-rl; font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--d-faint); margin-top: 10px; }

      :global(.js) .scroll-hint {
        display: flex; flex-direction: column; align-items: center; gap: 8px;
        position: absolute; left: 50%; bottom: 18px; transform: translateX(-50%); z-index: 3;
        font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--d-faint);
      }
      .scroll-hint i { width: 1px; height: 34px; background: linear-gradient(var(--gold), transparent); transform-origin: top; animation: hint 1.8s ease-in-out infinite; }
    }
    @keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-9px); } }
    @keyframes hint { 0% { transform: scaleY(0); opacity: 0; } 40% { opacity: 1; } 100% { transform: scaleY(1); opacity: 0; } }

    /* TRUST */
    /* Extra bottom padding so the white logo plates sit well inside the dark
       band and never touch the light section below. */
    .trust { padding: clamp(56px, 7vw, 88px) 0 clamp(88px, 9vw, 120px); }
    .trust-title { color: var(--d-faint); justify-content: center; }
    .trust-plate { display: inline-flex; align-items: center; justify-content: center; height: 58px; padding: 0 22px; background: var(--paper-2); border: 1px solid var(--line-d); border-radius: 12px; flex: none; }
    .trust-logo { height: 32px; width: auto; object-fit: contain; }

    /* POSITIONING */
    .reposition { font-size: clamp(2rem, 4.4vw, 3.4rem); line-height: 1.08; }

    /* RANGE: small to complex */
    .range-card { display: flex; flex-direction: column; }
    .range-badge { align-self: flex-start; font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gold); border: 1px solid var(--gold-deep); border-radius: 999px; padding: 5px 12px; margin-bottom: 16px; }
    .range-card h3 { margin-bottom: 10px; }
    .range-foot { margin-top: 40px; font-size: 1.05rem; color: var(--d-muted); }
    .grid-3 { grid-template-columns: repeat(3, 1fr); }
    @media (max-width: 900px) { .grid-3 { grid-template-columns: 1fr; } }
    @media (min-width: 561px) and (max-width: 900px) { .grid-3 { grid-template-columns: 1fr 1fr; } }

    /* PILLARS */
    .pillar-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
    .pillar .index { display: block; margin-bottom: 14px; }
    .pillar h3 { margin-bottom: 12px; }

    /* SOFTWARE */
    .software-grid { display: grid; grid-template-columns: 1fr 0.9fr; gap: clamp(32px, 5vw, 72px); align-items: center; }
    .feature-list { list-style: none; display: grid; gap: 14px; }
    .feature-list li { position: relative; padding-left: 26px; color: var(--d-muted); font-size: 1rem; }
    .feature-list li::before { content: "→"; position: absolute; left: 0; color: var(--gold); font-family: var(--font-mono); }
    .feature-list strong { color: var(--d-text); font-weight: 600; }
    .software-visual { display: grid; gap: 18px; }
    .stack-card { background: var(--ink); border: 1px solid var(--line-d-2); border-radius: 14px; padding: 18px; box-shadow: 0 30px 70px -50px #000; }
    .stack-card.offset { margin-left: 40px; }
    .stack-head { font-family: var(--font-mono); font-size: 0.72rem; color: var(--d-muted); letter-spacing: 0.04em; display: flex; align-items: center; gap: 10px; margin-bottom: 16px; }
    .stack-cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
    .col-label { font-family: var(--font-mono); font-size: 0.6rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--d-faint); display: block; margin-bottom: 8px; }
    .chip { background: var(--ink-3); border: 1px solid var(--line-d); border-radius: 8px; padding: 8px 10px; font-size: 0.76rem; color: var(--d-muted); margin-bottom: 8px; }
    .chip.gold-chip { border-color: var(--gold-deep); color: var(--gold-soft); }
    .report-rows { display: grid; gap: 0; }
    .report-row { display: flex; justify-content: space-between; align-items: center; padding: 11px 0; border-bottom: 1px solid var(--line-d); font-size: 0.9rem; color: var(--d-muted); }
    .report-row:last-child { border-bottom: 0; }
    .report-row b { font-family: var(--font-display); font-weight: 480; color: var(--d-text); font-size: 1.15rem; }

    /* PROCESS */
    .process-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
    .process-step { border-top: 1px solid var(--line-l-2); padding-top: 22px; }
