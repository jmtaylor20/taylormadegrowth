---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import wcLogo from '../assets/wolfcreek_logo.png';
import wcWebsite from '../assets/wolfcreek_website.png';
import wcBusinessCard from '../assets/wolfcreek_business_card.png';
import wcTailgate from '../assets/wolfcreek_tailgate_wrap.png';
import wcSocial from '../assets/wolfcreek_social_post.png';
import wcBadge from '../assets/wolf-creek-badge-logo.png';

const built = [
  { n: '01', title: 'Brand identity', body: 'Logo, colors, and a stronger brand feel built around land, equipment, and trust.' },
  { n: '02', title: 'Website', body: 'A service-focused site that explains what Wolf Creek does and drives contact.' },
  { n: '03', title: 'Print materials', body: 'Business cards and customer pieces that create a professional first impression.' },
  { n: '04', title: 'Social media', body: 'Launch and partnership graphics that make the brand recognizable online.' },
];

const gallery = [
  { src: wcBusinessCard, label: 'Business card' },
  { src: wcTailgate, label: 'Tailgate wrap concept' },
  { src: wcSocial, label: 'Social launch graphic' },
  { src: wcBadge, label: 'Logo system' },
];
---

<Base
  title="Wolf Creek Farms Growth Project | Taylormade Brands"
  description="How Taylormade Brands partnered with Wolf Creek Farms on a rebrand, website, print materials, and a growth foundation for a land-management company."
>
  <main>
    <!-- HERO -->
    <section class="ink page-hero grid-bg glow-gold">
      <div class="container wide">
        <div class="hero-split">
          <div>
            <p class="label">Growth project · Land management</p>
            <h1 class="display">Wolf Creek Farms</h1>
            <p class="lead muted">Rebranding a respected land-management company with a stronger visual identity, a cleaner website, and a practical foundation for future growth.</p>
            <div class="btn-row mt-m">
              <a href="/growth-assessment.html" class="btn btn-primary">Start an assessment <span class="arrow">→</span></a>
              <a href="/work.html" class="btn btn-ghost">See more work</a>
            </div>
          </div>
          <div class="card summary-card reveal">
            <span class="wc-logo-plate"><Image src={wcLogo} alt="Wolf Creek Farms logo" width={360} /></span>
            <p class="label plain mt-m">Project included</p>
            <ul class="check-list mt-s">
              <li>Complete rebrand</li>
              <li>New website</li>
              <li>Business cards</li>
              <li>Tailgate wrap concept</li>
              <li>Social media graphics</li>
              <li>Growth strategy</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- CHALLENGE -->
    <section class="paper section">
      <div class="container wide split">
        <div>
          <p class="label">The challenge</p>
          <h2>A strong company needed a brand that matched the quality of the work.</h2>
          <p class="lead muted mt-s">Wolf Creek already had experience, equipment, and reputation. The opportunity was a sharper public image to support trust, visibility, and future lead generation.</p>
        </div>
        <div class="card">
          <h4>What needed to improve</h4>
          <ul class="check-list mt-m">
            <li>More professional brand presentation</li>
            <li>Clearer service communication</li>
            <li>Modern website presence</li>
            <li>Consistent visual identity</li>
            <li>Better customer-facing pieces</li>
            <li>Foundation for Google &amp; social growth</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- BUILT -->
    <section class="ink section">
      <div class="container wide">
        <div class="head"><p class="label">What we built</p><h2>A brand system built for land work — and growth.</h2></div>
        <div class="grid-4">
          {built.map((b) => (
            <div class="card num-card reveal"><span class="index">{b.n}</span><h3>{b.title}</h3><p class="muted">{b.body}</p></div>
          ))}
        </div>
      </div>
    </section>

    <!-- GALLERY -->
    <section class="paper section">
      <div class="container wide">
        <div class="head"><p class="label">Brand gallery</p><h2>Pieces designed to make the company look established.</h2></div>
        <div class="feature-shot reveal"><Image src={wcWebsite} alt="Wolf Creek Farms website" width={1200} /></div>
        <div class="grid-4 mt-m">
          {gallery.map((g) => (
            <figure class="gallery-item reveal"><Image src={g.src} alt={g.label} width={640} /><figcaption>{g.label}</figcaption></figure>
          ))}
        </div>
      </div>
    </section>

    <!-- FOUNDATION -->
    <section class="ink-2 section">
      <div class="container wide">
        <div class="head center mx-auto"><p class="label center mx-auto">Growth foundation</p><h2>The goal wasn't one graphic. It was a system.</h2></div>
        <div class="grid-4 foundation">
          <div class="card">SEO-focused service structure</div>
          <div class="card">Lead capture pathway</div>
          <div class="card">Google-ready presence</div>
          <div class="card">Brand consistency</div>
          <div class="card">Customer trust pieces</div>
          <div class="card">Social launch assets</div>
          <div class="card">Print-ready tools</div>
          <div class="card">Advertising foundation</div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="ink section">
      <div class="container narrow center">
        <p class="label center mx-auto">Start here</p>
        <h2 class="mt-s">Ready to modernize your business?</h2>
        <p class="lead muted mt-s mx-auto" style="max-width:54ch;">Take the growth assessment and I'll review your brand, presence, and lead flow.</p>
        <a href="/growth-assessment.html" class="btn btn-primary mt-m">Start assessment <span class="arrow">→</span></a>
      </div>
    </section>
  </main>

  <style>
    .summary-card { align-self: stretch; }
    .wc-logo-plate { display: flex; align-items: center; justify-content: center; background: var(--paper); border: 1px solid var(--line-d); border-radius: 12px; padding: 22px; }
    .wc-logo-plate :global(img) { max-height: 90px; width: auto; object-fit: contain; }
    .feature-shot { border: 1px solid var(--line-l); border-radius: 16px; overflow: hidden; box-shadow: 0 40px 90px -55px rgba(11,14,20,.4); aspect-ratio: 16 / 9; }
    .feature-shot :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: top; }
    .gallery-item { border: 1px solid var(--line-l); border-radius: 14px; overflow: hidden; background: var(--paper-2); }
    .gallery-item :global(img) { width: 100%; height: 190px; object-fit: cover; object-position: center; }
    .gallery-item figcaption { font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.06em; color: var(--l-muted); padding: 13px 16px; border-top: 1px solid var(--line-l); }
    .foundation .card { display: flex; align-items: center; font-weight: 500; }
    @media (max-width: 900px) { .split, .hero-split { grid-template-columns: 1fr; } .grid-4 { grid-template-columns: 1fr 1fr; } }
    @media (max-width: 560px) { .grid-4 { grid-template-columns: 1fr; } }
  </style>
</Base>
