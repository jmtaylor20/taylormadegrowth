---
import Base from '../layouts/Base.astro';
---

<Base
  title="Portfolio | Taylormade Brands"
  description="View or download the Taylormade Brands business growth portfolio."
>
  <main>
    <section class="portfolio-simple-hero">
      <div class="container portfolio-simple-grid">
        <div>
          <p class="eyebrow">Business Growth Portfolio</p>
          <h1>View the full Taylormade Brands portfolio.</h1>
          <p>
            See examples of branding, websites, marketing systems, and business growth projects
            built for local businesses.
          </p>

          <div class="button-row">
            <a href="/TMB_portfolio.pdf" class="button primary" target="_blank" rel="noopener">View Portfolio PDF</a>
            <a href="/TMB_portfolio.pdf" class="button secondary" download>Download Portfolio</a>
          </div>
        </div>

        <div class="portfolio-simple-card">
          <h3>Inside the PDF</h3>
          <ul>
            <li>Branding examples</li>
            <li>Website examples</li>
            <li>Marketing systems</li>
            <li>Client growth projects</li>
            <li>Consulting philosophy</li>
          </ul>
        </div>
      </div>
    </section>
  </main>
</Base>
