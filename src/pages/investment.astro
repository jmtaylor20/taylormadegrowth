---
import Base from '../layouts/Base.astro';

const services = [
  {
    tag: 'Websites',
    title: 'Website Design & Development',
    price: 'Custom website packages available',
    body: 'From a clean starter site to a full custom build, priced to fit what your business actually needs.',
  },
  {
    tag: 'Growth',
    title: 'Growth Management',
    price: 'Monthly plans starting at $400/month',
    body: 'Ongoing care for your website, Google presence, reviews, and reporting, so growth keeps compounding after launch.',
    featured: true,
  },
  {
    tag: 'Advertising',
    title: 'Google Ads',
    price: 'Custom management based on market and ad spend',
    body: 'Search campaigns built and managed around your market, your budget, and the leads that actually turn into work.',
  },
  {
    tag: 'Branding',
    title: 'Branding & Rebranding',
    price: 'Brand & rebrand packages available',
    body: 'Logos, brand kits, and full rebrands that make your business look as good as the work you do.',
  },
  {
    tag: 'Software',
    title: 'Custom Software & Web Apps',
    price: 'Custom quotes for apps, portals & automation',
    body: 'Client portals, booking and registration systems, dashboards, and internal tools built around how you run.',
  },
  {
    tag: 'Partnership',
    title: 'Growth Partnership',
    price: 'One partner across the whole stack',
    body: 'Strategy, software, research, reporting, and marketing under one partner on an ongoing basis.',
  },
];
---

<Base
  title="Pricing | Taylormade Brands"
  description="Simple, honest pricing built around your business. Custom website packages, growth management from $400/month, Google Ads, branding, and custom software. Start with a free online visibility audit."
>
  <main>
    <!-- HERO -->
    <section class="ink page-hero grid-bg glow-gold">
      <div class="container wide">
        <p class="label">Pricing</p>
        <h1 class="display" style="max-width: 17ch;">Pricing built to start a conversation, not end one.</h1>
        <p class="lead muted" style="max-width: 62ch;">
          No long contracts and no pressure. Every project is scoped and priced up front, so you know
          exactly what you are getting before anything begins. The easiest first step costs nothing.
        </p>
        <div class="btn-row mt-m">
          <a href="/free-audit.html" class="btn btn-primary">Get your free online visibility audit <span class="arrow">→</span></a>
          <a href="/contact.html" class="btn btn-ghost">Talk it through</a>
        </div>
      </div>
    </section>

    <!-- SERVICES -->
    <section class="paper section">
      <div class="container wide">
        <div class="head">
          <p class="label">What we offer</p>
          <h2>Find the piece that fits where you are.</h2>
          <p>Start with one thing or build the whole system over time. Exact pricing is set once we understand your business, and it is always laid out clearly before you commit.</p>
        </div>
        <div class="grid-3">
          {services.map((s) => (
            <article class={`card svc-card reveal ${s.featured ? 'svc-featured' : ''}`}>
              {s.featured && <span class="ribbon">Most popular</span>}
              <span class="tag">{s.tag}</span>
              <h3 class="mt-s">{s.title}</h3>
              <p class="svc-price">{s.price}</p>
              <p class="muted">{s.body}</p>
              <a href="/contact.html" class="text-link svc-link mt-s">Ask about this <span class="arrow">→</span></a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- HOW PRICING WORKS -->
    <section class="ink section">
      <div class="container wide">
        <div class="head center mx-auto">
          <p class="label center mx-auto">How pricing works</p>
          <h2>Clear, flexible, and built around you.</h2>
        </div>
        <div class="grid-3">
          <div class="card num-card reveal"><span class="index">01</span><h3>Scoped up front</h3><p class="muted">Every project is quoted in plain terms before it starts. No surprise invoices and no guessing.</p></div>
          <div class="card num-card reveal"><span class="index">02</span><h3>No long contracts</h3><p class="muted">Monthly plans stay month to month. You continue because it is working, not because you are locked in.</p></div>
          <div class="card num-card reveal"><span class="index">03</span><h3>One partner, real reporting</h3><p class="muted">One point of contact across everything, with reporting that shows what your investment is producing.</p></div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="ink-2 section">
      <div class="container narrow center">
        <p class="label center mx-auto">Start here, free</p>
        <h2 class="mt-s">Not sure what you need yet? Start with a free audit.</h2>
        <p class="lead muted mt-s mx-auto" style="max-width:58ch;">
          I will review your website and online presence and send back a short report on what is costing you
          calls, with no cost and no obligation. It is the easiest way to see where to start.
        </p>
        <div class="btn-row mt-m" style="justify-content:center;">
          <a href="/free-audit.html" class="btn btn-primary">Get your free online visibility audit <span class="arrow">→</span></a>
          <a href="/contact.html" class="btn btn-ghost">Book a conversation</a>
        </div>
      </div>
    </section>
  </main>

  <style>
    .svc-card { display: flex; flex-direction: column; position: relative; }
    .svc-featured { border-color: var(--gold-deep); box-shadow: 0 30px 70px -45px rgba(201,162,74,.35); }
    .ribbon { position: absolute; top: -11px; left: 30px; background: var(--gold); color: #201808; font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.06em; text-transform: uppercase; padding: 4px 12px; border-radius: 999px; }
    .svc-price { font-family: var(--font-display); font-weight: 480; font-size: 1.28rem; line-height: 1.25; letter-spacing: -0.01em; color: var(--gold-deep); margin: 6px 0 12px; }
    .svc-card .muted { flex: 1 0 auto; }
    .svc-link { font-size: 0.92rem; }
    @media (max-width: 900px) { .grid-3 { grid-template-columns: 1fr; } }
    @media (min-width: 561px) and (max-width: 900px) { .grid-3 { grid-template-columns: 1fr 1fr; } }
  </style>
</Base>
