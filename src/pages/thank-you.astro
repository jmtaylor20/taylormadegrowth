---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import logo from '../assets/TMB_ScriptStack_White_Logo.png';
import { analytics } from '../config/analytics';

const conv = analytics.conversions.contactForm;
---

<Base title="Thank You | Taylormade Brands" chrome={false}>
  <section class="thank-you-page">
    <div class="container narrow">
      <Image src={logo} alt="Taylormade Brands" width={120} style="width:100px; margin:0 auto 30px; display:block; filter:brightness(0) invert(1);" />

      <h1>Thank You!</h1>

      <p>
        Your message has been sent successfully.
        I'll follow up with you soon.
      </p>

      <a href="/index.html" class="button primary">Return Home</a>
    </div>
  </section>

  <script is:inline define:vars={{ conv }}>
    if (window.gtag) {
      gtag('event', 'generate_lead', { form: 'contact' });
      if (conv) gtag('event', 'conversion', { send_to: conv });
    }
  </script>
</Base>
